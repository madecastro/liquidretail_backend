# liquidretail_adgen env
#
# Precedence rule (mirrors backend): process env wins over any file. In production
# on Render, only SECRETS live in the dashboard. Everything else in a committed
# config once we have one — Phase 0 keeps it simple with .env.example alone.

# Which role this instance runs. One of: api | orchestrator | renderer
ADGEN_ROLE=api

# Mongo cluster. MUST point at staging in dev — this service will read/write the
# same collections as backend when Phase 1 ships.
MONGODB_URI=

# HTTP port for the api role. Ignored by orchestrator/renderer.
PORT=3100

# Polling interval for the orchestrator + renderer roles (ms). Sub-second is
# fine — Mongo claim is cheap. Default 500ms.
ADGEN_POLL_MS=500

# Slack alerting — Phase 1+ uses this for money/render alerts. Phase 0 can
# leave blank.
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=

# Worker identity — auto-generated at boot if unset. Used as the value in
# Ad.claimedByWorker so we can trace which worker holds a given claim.
ADGEN_WORKER_ID=

# Log verbosity for the workers. Phase 0 emits "alive" heartbeats every 30s.
ADGEN_LOG_LEVEL=info
