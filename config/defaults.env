# config/defaults.env — non-sensitive runtime configuration, versioned WITH the repo.
#
# WHY: feature flags, tuning knobs, and public identifiers/URLs used to live
# only as Render dashboard env vars, which meant every change required a
# manual dashboard edit and the current config wasn't visible in code review.
# They now live here and travel with the repo. SECRETS DO NOT — API keys,
# tokens, DB URIs, OAuth client secrets, and signing/encryption keys stay in
# the Render environment (see the "stays in Render env" list in docs/PIPELINES.md).
#
# MIGRATION COMPLETE (2026-08-03). Owner rule: "The dashboard in render should
# only contain secrets, everything else should be editable outside of the
# dashboard." Verified live: WEB 64→23 env vars (41 deleted), WORKER 24→14
# (10 deleted). Every deleted key already lived here with an identical value
# (runtime no-ops) EXCEPT RENDER_CONCURRENCY (dashboard pinned 4, file says 8
# — deleting the dashboard copy made 8 live; see CLAUDE.md §4a). Delete rule:
# only delete a dashboard var that exists in this file with an identical
# value; a dashboard-only var (e.g. JIRA_PROJECT_KEY) must be migrated INTO
# this file first, never just deleted.
#
# PRECEDENCE (index.js:1-5 / worker.js:18-20): the process environment (Render
# dashboard, or a local .env) is loaded FIRST and always wins; this file only
# fills vars that aren't already set. dotenv NEVER overrides an already-set
# var. A value here is the EFFECTIVE value only when no dashboard var of that
# name exists. A var set in BOTH places with DIFFERENT values is a silent
# config lie — diagnostic: compare the dashboard list against
# `grep -oE '^[A-Z_][A-Z0-9_]*=' config/defaults.env`. You can still override
# any value per-environment via Render env without editing this file. NEVER
# put a secret in this file; it is committed to git.

# ── AI creative pipeline feature flags ───────────────────────────────
AI_CONCEPT_DRIVEN=true
AI_HTML_LAYOUT_ENABLED=true
AI_LAYOUT_DIRECT_HTML=true
CANONICAL_DR_V1=true
RENDER_USE_HTML=true
RENDER_USE_RESOLVED=true

# How many candidate images the Director sees when the operator picked none.
# Default 1. CORRECTED 2026-08-03: this used to say "Default 1 = hero only".
# It is a COUNT, not a choice of image — it trims a ranked pool. WHICH image is
# pinned separately by preferFirstCatalogImage
# (seededUniverseService.promoteFirstCatalogImage): UPDATED 2026-08-05 (owner
# directive) — the pinned image is now the merchant feed's primary image,
# resolved CatalogProduct.imageMediaId -> media.metadata.feedIndex===0, not the
# imageRole=hero label or a shotType rank. See CATALOG_FEED_ORDER_SEEDING below.
# The cascade still can only ever select role=catalog media, so it can never
# resolve to a social/UGC post.
# Ceiling is 10; multi-image support stays fully wired — raise this (or the
# Render env override) to widen the window later. Operator multi-select still
# widens via Math.max(mediaIds.length, TOP_N).
# See docs/PIPELINES.md §5 "Seed selection — image vs video (the first-catalog-
# image rule)".
DIRECTOR_UNIVERSE_TOP_N=1

# CATALOG_FEED_ORDER_SEEDING — added 2026-08-05, owner directive. Default ON
# (unset/empty = on; only 0/false/no/off turns it off).
# WHAT IT CONTROLS: the DEFAULT (no operator picks) seed image for both static
# concept-driven generation (seededUniverseService.promoteFirstCatalogImage)
# and deterministic video generation (campaignAdsGenerationService.
# firstCatalogMediaForProduct + the reference-stack order built in
# atlasVideoService.generateForAd / sortCatalogMediasForReferenceStack).
# Owner, verbatim 2026-08-05: "the primary image as defined by the merchant
# feed is the main image that should be used for static, and the first image
# for video, the second and third image for video should be the first and
# second other images in the feed, as they appear in the feed ... The Hero
# stamp is not relevant when selecting images for video or static catalog
# generations."
# ON: the seed is the merchant feed's primary image, resolved as
#   TIER 1  CatalogProduct.imageMediaId — the LIVE pointer, rewritten on every
#           (re-)detect;
#   TIER 2  media.metadata.feedIndex === 0 — the ingest-time stamp (0 =
#           product.imageUrl, 1..N = additionalImages in stored order),
#           reached when the pointer is absent;
#   TIER 3  (static only) best shot-type-ranked catalog image.
# Unconditional at every tier: no shot-type rank, no createdAt tiebreak, and
# (video) no subject-dominance skip. THE POINTER IS CHECKED BEFORE THE STAMP
# ON PURPOSE — feedIndex is denormalised onto the Media doc and nothing clears
# it when a merchant replaces their primary image, so a stamp-first cascade
# would seed a billable render from a retired photo.
# Because tier 1 needs no stamp, this rule is CORRECT ON EXISTING DATA without
# waiting for scripts/backfillMediaFeedIndex.js. Run the backfill anyway: it is
# what puts refs 1/2 of the VIDEO stack in feed order (that ordering reads
# feedIndex only) and what makes tier 2 reachable for non-primary variants.
# OFF: restores the pre-2026-08-05 cascades byte-for-byte in all three places —
# imageRole=hero tier, shotType-rank / createdAt fallback, and (video) the
# VIDEO_SEED_FEED_ORDER + VIDEO_SEED_MAX_SUBJECT_FRACTION guard.
# WHY A SWITCH: this changes what a billable image/video generation is seeded
# with, so per this file's own convention it must be reversible without a
# deploy.
CATALOG_FEED_ORDER_SEEDING=true

# VIDEO_OPERATOR_STACK_ONLY — added 2026-08-05, owner directive. Default ON
# (unset/empty = on; only 0/false/no/off turns it off).
# WHAT IT CONTROLS: the PRODUCT ANCHOR branch inside
# campaignAdsGenerationService.expandDeterministicVideo — the case where the
# operator has already picked images for a product AND none of those picks is
# a catalog mirror for that product. (The no-picks / default feed-seed branch
# is untouched.)
# Owner, verbatim 2026-08-05: "let's also address the extra image being
# appended, if it doesn't have a catalog image just signal the user there is
# no catalog image and if they choose to override that is at their
# discretion."
# ON: NEVER append a catalog anchor the operator did not choose.
#   referenceMediaIds stays exactly the operator's picks (picks.slice()).
#   firstCatalogMediaForProduct is still probed — but ONLY to decide which
#   perProduct.warning to stamp (no_catalog_in_picks vs no_catalog_image),
#   never to mutate the stack. The product still queues normally.
# OFF: restores the pre-2026-08-05 behaviour byte-for-byte — if a catalog
#   image exists and is not already in the picks, it is PUSHED onto
#   referenceMediaIds after the operator's picks (position 0 stays theirs).
# MONEY / IDENTITY DIGEST: computeDeterministicVideoDigest hashes
#   referenceMediaIds (order-significant). Dropping the appended anchor
#   CHANGES the digest for any stack that previously got one. Consequences:
#   (1) a re-Generate with the same non-catalog picks after this ships will
#       NOT collide with the old [...picks, anchor] ad; it mints a NEW ad
#       and can bill once more;
#   (2) it does NOT double-bill within a single expansion (still one payload
#       per product);
#   (3) identical post-change stacks still dedupe normally.
#   Do not try to "fix" this — a different stack IS a different creative.
# WHY A SWITCH: this changes what is sent to a ~$1 billable Omni video
# generation, so per this file's own convention it must be reversible without
# a deploy.
VIDEO_OPERATOR_STACK_ONLY=true

# Catalog-first reseed on STATIC regenerate (services/adRegenerateService.js).
# Default ON (unset/empty = on; only 0/false/no/off turns it off).
# WHY IT EXISTS: regenerate used to REPLAY the stored Ad.mediaIds stack forever,
# so an ad queued while DIRECTOR_UNIVERSE_TOP_N was 10 still sends 3+ references
# on every regen today. This re-DERIVES the seed instead (imageRole=hero → the
# earliest-createdAt catalog entry → nothing), every query pinned to
# source:'catalog-product' + the ad's own product AND brand, so it can never
# resolve to a UGC/social post. NOT a trim: the historical stacks were
# shotType-ranked LIFESTYLE-FIRST over a catalog+UGC merged pool, so mediaIds[0]
# is often a UGC post and trimming to it would lock a social image in as the
# seed. Gated to variantKind='product_image' only (owner: "UGC ads shouldn't be
# affected by this change, we haven't optimized that path yet") and skipped
# whenever Ad.referenceMediaIds is non-empty (an explicit operator pick wins).
# WHY A SWITCH: it changes how ALREADY-GENERATED ads look when regenerated, so
# it must be reversible without a code deploy. Nothing is persisted back onto the
# Ad, so flipping this off restores the old output on the next regen.
# NOT a money knob — reference COUNT does not move the price and the number of
# billable submits is unchanged (still exactly one gpt-image-2/edit per regen).
REGEN_RESEED_CATALOG_FIRST=true

# UGC_FIRST_SEEDING — added 2026-08-10, UGC-ads Phase 3. Default ON.
# When ON, opts.preferUgcMediaId passed into seededUniverseService.buildSeeded-
# Universe hoists that Media to seed index 0 AFTER promoteFirstCatalogImage
# (so catalog-first lands at position 1 rather than displacing the UGC).
# routes/ads.js /generate stamps CampaignRun.seedUgcIds so adRegenerateService
# replays the same UGC as ref 1 on every regen — otherwise regen's catalog-
# first cascade would clobber the UGC seed.
# Also feature-flags atlasVideoService.sortCatalogMediasForReferenceStack's
# preferUgcMediaId opt (currently a no-op on real data — catalog-only stack —
# but the plumbing has to stay revert-proven for symmetry).
# WHY A SWITCH: the Phase 2 wizard passes preferUgcMediaId unconditionally, so
# this flag is the ONLY revert lever between "UGC at seed 0" and "shotType
# ranking picks the seed". Pinned by scripts/verifyUgcFirstSeeding.js
# (revert-proven on two mutations: gate removed and promoteUgcFirst gutted).
UGC_FIRST_SEEDING=true

# UGC_VIDEO_PASSTHROUGH — added 2026-08-11, UGC-ads Phase 5. Default OFF.
# When ON, ads whose source Media is a UGC video (fileType='video' AND
# either a social source or any operator-added attachment) skip the
# ~$3 Omni image-to-video submit entirely: services/ugcVideoPipeline.js
# mirrors the source into Cloudinary on the first pass (caches
# secure_url on Media.fileUrl) and hands a segment URL back as the
# master; downstream Remotion titling composites over it. Cost drops
# to ~$0/master, wall time ~15s vs ~2 min.
# WHY OFF BY DEFAULT (opposite of UGC_FIRST_SEEDING): this touches the
# money path directly. A hidden regression here would silently double-
# submit (Omni + a bad passthrough) or silently under-render (skipping
# ads that should have generated). Rollout: flip to true after one
# real Apify-scraped UGC-video ad has generated + rendered + been
# regenerated successfully.
# W2 DECISION — on mirror failure or timeout, the ad is SKIPPED with a
# structured failure state; it is NEVER silently routed to Omni. That
# would defeat the "no Omni submit" invariant on the exact class of
# failure (slow Cloudinary) the switch exists to survive. Pinned by
# scripts/verifyUgcVideoPassthrough.js (D5/D6 for /generate, R4/R5 for
# regen; revert-proven).
UGC_VIDEO_PASSTHROUGH=false

# FEED_TRUTH_CATEGORIES — added 2026-08-11, owner directive. Default ON.
# The merchant feed's own category is the authoritative categoryRef, not
# a downstream inferred breadcrumb.
# On sync, catalogSyncService uses categoryClassifier.resolveFeedCategoryRef
# — rich breadcrumbs ("Apparel & Accessories > Clothing > Shirts") become
# multi-level trees, single-term product_type strings become depth-0 leaves.
# The 9-bucket inferCoarseEnum path is only used when the feed provides no
# category at all.
# Downstream inferred stampers guard on categoryRef=null:
#   • productCategoryInferenceService (JSON-LD scrape) still writes
#     inferredBreadcrumb + inferredCategoryAt, but does not overwrite an
#     existing categoryRef.
#   • productMatchService (GPT-4.1 brand-nav) still writes match.brandCategory
#     and CatalogProduct.category (display string), but does not overwrite an
#     existing categoryRef.
# WHY A SWITCH: this changes what shows in the wizard's Category picker,
# the Product Ads / UGC Ads chips, and the pre-match filter's subtree scan.
# Flip to false to fall back to the pre-change coarse-first behaviour if
# feed strings turn out to be lower-quality than inferred (unlikely for
# Meta / Shopify but possible on some ingest paths).
FEED_TRUTH_CATEGORIES=true

# STATIC PROMPT — product-fidelity hardening (owner-directed 2026-08-03).
# ON = the long PRODUCT FIDELITY block at the top of every static ad prompt
# (services/staticAdIntents.js `PRODUCT_FIDELITY`): the reference photograph is
# the sole source of truth, do not infer the product from its category or from
# brand priors, preserve form / construction / surface / colour / on-item
# graphics / details / condition exactly, plus the matching carve-outs that stop
# the no-added-text rules from erasing the product's OWN printed label.
# Targets product drift — hallucinated logos, shifted colour, altered fit.
# WHY A SWITCH, and why it reverts EVERYTHING: PR #61 hardened the VIDEO prompt
# the same way and the owner rolled all three parts back ("this is creating
# additional hallucinations and the previous output was better" — CLAUDE.md §00).
# The same outcome is possible here, and the cost is not hypothetical: the block
# more than doubles the prompt (~3.5-4.1k → ~7.8-8.4k chars) and sits above SET
# EXACTLY THESE STRINGS, on a path whose measured text fidelity is 139/140
# strings across 20 renders and where quality:high already measured WORSE than
# medium by losing a string. So `false` restores a BYTE-IDENTICAL pre-hardening
# prompt — the block, the `absences` carve-outs and the `textBlock` carve-outs
# all revert together. A flag that reverted only part of it would give an A/B
# whose control arm is not the arm that was measured.
# Pinned by scripts/verifyStaticFidelityPrompt.js (both arms).
# NOT a money knob — prompt text does not change the price and the number of
# billable submits is unchanged (still one gpt-image-2/edit per surface).
STATIC_PROMPT_FIDELITY_HARDENING=true

# ── Lifestyle / UGC preserve pathway (owner-specified 2026-08-11) ────────────
# WHY: the static prompt never learned whether its seed was a real lifestyle
#   photograph or a studio packshot — grep shotType/shotStyle/background.setting
#   in staticAdIntents.js + directImageRenderService.js and you get ZERO hits. So
#   a genuine lifestyle photo was handed to gpt-image-2/edit with product-fidelity
#   rules and total freedom over the scene. Whatever made that photo worth using
#   — the location, the light, the person, the moment — was protected by nothing.
#
# STATIC_LIFESTYLE_PRESERVE — swaps the scene-BUILDING fidelity opening for a
#   SCENE_PRESERVE block when the seed is lifestyle (resolveSeedStyle) OR the ad
#   is variantKind==='ugc'. Never for packshot/flat_lay/detail/packaging/unknown/
#   ambiguous — a synthesized scene is correct there.
#   IT IS A MODIFIER, NOT AN INTENT. Owner: "copy should be determined by the
#   intent profile requested by the director." Intent selection, resolveIntent,
#   FALLBACK_ORDER and every eligible() gate are untouched; the Director's intent
#   keeps owning all copy roles AND their order. Verified empirically across all
#   four intents — roles/emphasis/drops byte-identical preserve-on vs off.
#   Compositing only: a soft scrim behind type IS allowed for legibility over a
#   busy photo (that is chrome), but the photograph's pixels do not change.
#   The titling safe box already exists via computeSurface/geometryBlock — this
#   does not add space, it stops the model recomposing the frame.
#   ENABLED 2026-08-11 after round-4 review. Shipped dark through three review
#   rounds first; every round found real defects in the dormant code, which is
#   why it shipped dark. Coverage confirmed against production before the flip:
#   Media carries classification.shotType==='lifestyle' at 95% confidence
#   (apify-ig seed on AllBirds), so this is not a no-op flip.
#   Aspect handling is per (surface x seed kind) via resolveAspectTreatment:
#   'extend' on Meta 1:1/4:5/9:16 + PMax square/portrait, 'native' when the seed
#   already matches (no extension sentence), and 'not-supported' on 16:9/PMax
#   landscape where preserve falls through to scene-build entirely — a 55-68%
#   invented frame is not "edge extension" and must not ship under a preserve
#   label. Flip back to false to disable; no code change needed.
STATIC_LIFESTYLE_PRESERVE=true
#
# VIDEO_LIFESTYLE_PROMPT — a SIBLING directive set, not a prepend.
#   WHY A SIBLING: OMNI_DIRECTIVES is a PACKSHOT prompt end to end — "product
#   commercial editor", "premium product commercial using subtle Ken Burns",
#   "high-end ecommerce", "the product stays completely static", "animate the
#   product or any of its parts" in doNot. Point a lifestyle photo at that and you
#   get a slow pan over a frozen moment. A prepend CANNOT fix it: "let the scene
#   breathe" directly contradicts "the only motion is the virtual camera".
#   So LIFESTYLE_DIRECTIVES is selected instead, only for a lifestyle seed with
#   this flag on. KEEPS unrelaxed: product identity absolute (the product stays
#   physically still while the world around it may breathe), that-scene-only, no
#   generated text, and physicalAccuracy HEIGHTENED because hands and faces are
#   where these models fail first once motion is permitted.
#   ALSO SENDS 1 REFERENCE, not the 3-distinct stack: multi-reference is a
#   packshot fidelity device, and PR #61 was rolled back precisely because
#   demanding continuity across a reference stack made the model invent
#   intermediate body pixels. Several photos of a person plus "now animate" is
#   how you get melted hands. Packshot path keeps DEFAULT_REFERENCE_IMAGE_COUNT=3
#   and MAX_DISTINCT_REFERENCES=5, untouched.
#   OMNI_DIRECTIVES / GROK_DIRECTIVES are BYTE-UNCHANGED and verifyPostPilotBatch
#   B14 stays green with the harness unmodified — B14's matrix (caps x
#   hasProductReference x durationSec x seedHasText) does not include seed style,
#   so a new branch defaulting off leaves every combination it tests identical.
#   NOTE this reverses part of the 2026-08-03 posture ("do not plumb Director
#   signal into the camera prompt; archetype-driven video is deferred"). Owner
#   re-opened it 2026-08-11 for lifestyle ONLY. Director room is real but bounded:
#   pacing, mood, and which beat holds — via the videoPromptGuidance cascade on
#   top of the lifestyle base. Titling copy is untouched (Remotion from ad.copy).
#   ENABLED 2026-08-11 alongside STATIC_LIFESTYLE_PRESERVE. The apparel
#   contradiction is resolved: fidelity means IDENTITY, not IMMOBILITY. A worn
#   garment shifting with a breath is realism; demanding a frozen garment on a
#   living person is what produces uncanny output. The product may move only as
#   the real physical item would, never independently animated, re-posed,
#   re-draped, morphed or regenerated. Rigid goods still do not deform.
#   Flip back to false to disable; no code change needed.
#
# SCOPED 2026-08-11 (owner) — wiring KEPT, entry narrowed to the media path.
#
# WHAT WENT WRONG: the branch was entered on `seedStyle === 'lifestyle' ||
# variantKind === 'ugc'`, and resolveSeedStyle maps BOTH 'lifestyle' AND
# 'on_model' into the lifestyle bucket (imageShotHeuristicService
# LLM_LIFESTYLE). An on-model catalog packshot — activewear photographed on a
# person, i.e. most of an apparel catalogue — is a PRODUCT shot. So for brands
# like GymShark essentially every seed took this path WITHOUT anyone choosing
# it, and because the path caps references to 1, the operator's three picks
# were discarded on nearly every video. Observed live:
#   "lifestyle video path caps references to 1 (seed only; 3 operator picks reduced)"
# Every recent submit logged refs=1.
#
# THE FIX is in shouldUseLifestyleVideoPrompt, not here: entry is now
# variantKind === 'ugc' ONLY. Ad.variantKind is a required enum of exactly
# ['product_image','ugc'], so that is precisely "images through the MEDIA path,
# not through the product images path" (owner). The seed-style inference is
# gone; nothing enters on a classification nobody asked for.
#
# STILL OPEN, deliberately: on_model should not read as lifestyle when the
# subject is against a clean background — the technical heuristic already
# measures that (border stdev < 12 = studio sweep) but is short-circuited by
# the LLM shotType label. Left alone here because resolveSeedStyle is SHARED
# with the STATIC preserve path.
VIDEO_LIFESTYLE_PROMPT=true

# STATIC image edit model. REVERTED to the plain variant 2026-08-03 (owner), the
# same day the -developer switch was made, on measured reliability:
#   -developer  76 submits, 13 hard "prediction failed" (17.1%), across three
#               independent runs at 15.8% / 15.0% / 22.2% — consistent
#   plain       38 submits, 0 hard failures
# Each developer failure is a BILLED submit returning outputs:null with no error,
# which reaches the operator as a failed ad. Cost per SUCCESSFUL render still
# favoured developer ($0.0426 vs $0.0757) — this is deliberately NOT a cost
# decision. Re-measure before reaching for -developer again.
#
# HISTORICAL — kept verbatim for the record, superseded by the revert above.
# Describes the `-developer` variant AS IT WAS ORIGINALLY ADOPTED, hours before
# the same-day revert. Not current guidance; the live value is the line below.
# STATIC image edit model. Owner decision 2026-08-03: the `-developer` variant.
# Drop-in swap — request schemas are field-for-field identical (same required
# fields, same 14-value size enum, same quality enum, neither has input_fidelity)
# and both share one readme, verified live before the change.
# COST, MEASURED (never read a charge off `base_price` — it is a base and
# under-reports ~7x; see docs/ATLAS.md "base_price is not the charge"):
#   openai/gpt-image-2/edit            base 0.010  ->  charged $0.07173
#   openai/gpt-image-2-developer/edit  base 0.005  ->  charged $0.03586
# Halves static spend: a 3-surface meta_static fanout goes ~$0.215 -> ~$0.108
# per product. Submit COUNT is unchanged — still one edit per surface.
# (That revert already happened, above — this is not an instruction to act on.)
# Output quality between the two variants was NOT A/B'd.
# Reliability data behind the revert, measured 2026-08-03 (38 submits per
# model, NOT a controlled test — one of the three runs folded into the 17.1%
# blended rate above): developer 32/38 ok with 6 hard "prediction failed"
# (15.8%, null outputs); non-dev 36/38 ok with 0 hard failures. Cost per
# SUCCESSFUL render still favoured developer ($0.0426 vs $0.0757), but each
# failure is a charged submit with no asset that shows up as a failed ad.
AI_DIRECT_IMAGE_EDIT_MODEL=openai/gpt-image-2/edit

# Static-image ad production path. CORRECTED 2026-07-31 — the text above this
# line used to describe the GPT-4.1-authors-HTML → Puppeteer → photoreal-polish
# chain as "the default". It is not, and had not been for a day: every static
# ai_* ad goes through the direct image pipeline
# (services/directImageRenderService.js). The HTML path is a legacy fallback,
# selected per brand via Brand.staticImagePipeline='html' and nothing else.
#
# The image-ref "photoreal polish" shadow these four vars configured has been
# DELETED from the code (see the removal notes in aiCanvasSpecService.js). It
# made a billable gpt-image-2 call per canvas artifact for output no renderer
# read. The vars are kept only so an old deploy or a stray reference resolves to
# something inert — they are read by nothing on the render path now. Do not set
# any of them back to true expecting a polish step; there is no consumer.
#
# NOTE ALSO: these were set in the RENDER DASHBOARD, which overrides this file
# (index.js loads the real env first and dotenv never overrides an already-set
# var). They were flipped to false in the dashboard on both services the same
# day. Editing this file alone would NOT have changed prod.
AI_IMAGE_REFERENCE_ENABLED=false
AI_IMAGE_REF_MODEL_ID=gpt-image-2
AI_IMAGE_REF_QUALITY=high
IMAGE_REF_DUMP_SEEDS=false

# Brand website font ingest: attempt to download faces served from commercial
# foundry / webfont CDNs (Typekit, Cloud.typography, MyFonts, …) and treat them
# as usable when the mirror succeeds. Posture: the advertiser's own typeface in
# the advertiser's own ads — owner-accepted 2026-08. Classification still
# records license:'commercial' for audit; this flag only governs download + use.
# Set false to restore the old gate (flag-only, never download, never match).
BRAND_FONT_ASSUME_LICENSED=true

# ── Video (Veo / Atlas) ──────────────────────────────────────────────
AI_VEO_FEED=true
AI_VEO_REELS=true
AI_VIDEO_POSTER_ENABLED=true
AI_OVERLAY_POLISH_ENABLED=false
VIDEO_PROVIDER=atlas
VEO_USE_GPT_STORYBOARD=true
ATLAS_VIDEO_FORCE_CHROME=true
ATLAS_VIDEO_MODEL=
# 1080p, NOT the 720p schema default — and it is FREE. Atlas prices Omni as
# `(resolution == "4k" ? $1 : $0.2) + duration x $0.1`, and the model readme states
# outright: "720p and 1080p are identically priced." An 8s clip costs $1.00 either
# way, so 720p was paying the 1080p price for 720p pixels.
# 1080p is also exactly what Meta wants: every deliveryDims in platformFormats.js is
# 1080-wide (1080x1080 feed, 1080x1350 4:5, 1080x1920 reels/stories). At 720p a 9:16
# render is 720x1280 and every format needs an upscale; at 1080p the 9:16 render is
# 1080x1920 and a 1:1 crop lands at exactly 1080x1080 with no upscale at all.
# NOT 4k: it is the only tier that costs more ($1.80 for 8s vs $1.00) and Meta
# discards the extra pixels. Verified against the live Atlas schema + readme
# 2026-07-29; enum is 720p|1080p|4k.
ATLAS_VIDEO_RESOLUTION=1080p
ATLAS_POLL_INTERVAL_MS=15000
# Hook-first video camera prompt. When true, BOTH Meta and PMax video
# destinations use HOOK_FIRST_DIRECTIVES in veoPromptBuilder (hook-first
# timeline, centre-safe composition, aspect-aware Frame lines for 16:9 / 9:16).
#
# OWNER-DIRECTED STANDARDIZATION 2026-08-18, verbatim: "I want to use the PMax
# prompt for Meta also, and standardize on that but maintain a single minting
# for 9x16 across both formats. Continue to mint a 16x9." Before that date this
# was PMax-only and Meta ran the frozen pre-#61 gemini-omni prompt.
#
# REVERTED BY OWNER 2026-08-20, verbatim: "we want to revert the change i made
# to the prompt being used for Meta videos. I want to go back to the prompt I
# was using before we standardized on the pmax prompt ... I want to use this
# same prompt for PMax for now also." Both names are now set to "false" below,
# so BOTH platforms default to the frozen pre-#61 gemini-omni/grok camera
# prompt, byte-for-byte (the surviving PR #61 rollback guarantee — CLAUDE.md
# §00). Setting either name back to "true" restores the 2026-08-18 hook-first
# standardization for both platforms — the switch itself is unchanged; only
# the shipped default flipped. See CLAUDE.md §00 for the full history and the
# one real consequence: a mixed Meta+PMax run's shared-9:16-master saving
# ($1.80 vs $2.70) fails closed while this stays off, because that saving's
# conjunct 4 requires hook-first ON (`verifySharedPortraitMaster.js` F1/F6).
#
# TWO NAMES, EITHER ONE KILLS. PMAX_VIDEO_DIRECTIVES is the Phase B name and may
# already be set on the Render dashboard; VIDEO_HOOK_FIRST_PROMPT is the current
# name. An explicit "false" on EITHER disables. It is deliberately NOT
# "new name wins": dotenv loads this file without override, so a Render override
# of the legacy name would be silently shadowed by whatever value this file gave
# the new name. Do not "simplify" that to a precedence rule.
VIDEO_HOOK_FIRST_PROMPT=false
PMAX_VIDEO_DIRECTIVES=false

# UI-chrome hallucination guard (services/veoPromptBuilder.js
# isVideoUiChromeGuardEnabled) — default ON/true. Added 2026-08-19 after a
# P0 where two Omni masters (run_1787174963435_ff67021e, Marine Layer 2)
# baked a fake product-detail-page header/footer (nav bar, hamburger + bag
# icons, garbled + real product-name text) directly into the video plate.
# Confirmed against the RAW pre-titling Omni output and the seed images:
# the seeds were clean catalog photography, so this is a model
# hallucination, not a bad seed. Adds ONE extra prompt line naming the
# failure mode explicitly (nav/menu/icon/screenshot) — kept OUTSIDE the
# frozen OMNI_DIRECTIVES/GROK_DIRECTIVES text (CLAUDE.md §00 PR #61
# rollback) so flipping this can never touch that byte-identity pin.
# VERIFIED LIVE 2026-08-19: a real Omni submit (same product/brand/seed
# stack as the incident, run_1787174963435_ff67021e, predictionId
# 3e579bc492bd4da785d77316c8011c3c, Atlas-settled $0.90) with this flag
# forced true produced a 9:16 master with NO storefront chrome at any of
# six sampled timestamps (0.1/0.3/0.5/0.8/1.2/2.5s) — including t=0.1s and
# t=0.5s, exactly where the original defect was visible. Flipped to true
# on that evidence; flip back to false to instantly roll back to the
# pre-fix (byte-identical) prompt if anything regresses.
VIDEO_PROMPT_UI_CHROME_GUARD=true

# PMax funnel-titled video variants (free Remotion re-titles).
# ON (default): for each Google PMax video surface that already has a plate
#   (2 paid masters 9:16+16:9, plus the free 1:1 crop), mint 3 additional
#   titling-only Ads — awareness / consideration / conversion — each using
#   remotion/presets/canonical-<stage>-pmax10.json. ZERO Omni submits; they
#   reuse resolveDeriveFromMaster → renderDeriveOnlyVideoAd.
# OFF: byte-identical to pre-change minting (2 masters + 1 derive-only 1:1).
# Ad-count ON: 2 masters + 6 master-variants + 1 base 1:1 + 3 1:1-variants
#   = 12 video ads/product (still only 2 billable Omni submits).
PMAX_FUNNEL_VARIANTS=true
# Append the primary (position-0) reference image AGAIN as the FINAL ref so the
# Omni closing beat returns to the front view by construction.
# OFF (owner 2026-08-03): the repeated primary INCREASED hallucination and the
# pre-repeat output was better, so the default stack is the first 3 DISTINCT
# references with nothing appended. The matching return-to-primary prompt text
# was reverted out of veoPromptBuilder.js in the same change.
# Kept as a flag, not deleted, so the behaviour stays available for a future
# A/B: set true to re-enable (stack becomes up to 3 distinct + primary again =
# 4 total; distinct views are never dropped to make room for the duplicate —
# append only when under the total cap).
REPEAT_PRIMARY_REFERENCE=false

# ── Default reference stacks: VIDEO and STATIC, independently ───────────────
#
# Owner 2026-08-05: video defaults must be "the first, second and third catalog
# images as downloaded from the website or their Shopify feed" (usually front /
# side / back, but it varies), with the COUNT and the TYPE both settable here.
#
# COUNT — how many images the default stack uses when the operator picks nothing.
# VIDEO_DEFAULT_REFERENCE_COUNT is the FLOOR of the video cascade
# (CatalogProduct.videoSettings.referenceImageCount → Brand.videoSettings →
# ATLAS_REFERENCE_IMAGE_COUNT → this), so per-product overrides still win. It is
# also bounded per request by the model's own maxReferenceImages, a hard API
# limit that varies by model (omni i2v 7, omni r2v 5, veo3.1 and grok-imagine 1).
# IMAGE_DEFAULT_REFERENCE_COUNT governs the Step 2 picker's pre-pick (those picks
# POST as mediaIds and drive the run). It does NOT change the backend's own
# empty-mediaIds fallback, which stays DIRECTOR_UNIVERSE_TOP_N.
VIDEO_DEFAULT_REFERENCE_COUNT=3
IMAGE_DEFAULT_REFERENCE_COUNT=1
#
# SHOT TYPE — an ORDERED PREFERENCE, comma-separated, NOT a hard filter.
# Valid: lifestyle, on_model, product_only, flat_lay, detail, packaging, unknown.
# Matching media sort to the front in the order listed; everything else keeps its
# feed position behind them and NOTHING is dropped.
#
# ⚠️  Empty is the correct default and means PURE FEED ORDER — the "as
# downloaded" behaviour above. Leave it empty unless you specifically want to
# reorder. classification.shotType is written by the per-product detect pass, and
# detect is DEFERRED (CATALOG_DETECT_PRECOMPUTE=false), so a freshly ingested
# product has NO shotType on any of its media — which is exactly why this is a
# preference and not a filter. A filter would empty the stack for the newest
# products. Setting a preference simply has no effect until detect has run.
VIDEO_DEFAULT_REFERENCE_SHOT_TYPES=
IMAGE_DEFAULT_REFERENCE_SHOT_TYPES=

# Video SEED selection (which single image anchors the stack at position 0).
# Both were already implemented and honoured in code but lived ONLY in
# .env.example, so the sole way to change them was the Render dashboard — the
# opposite of the 2026-08-03 secrets-only decision. Surfaced here at their
# existing effective defaults; neither line changes behaviour.
#
# VIDEO_SEED_FEED_ORDER=true is the owner's 2026-08-03 decision #1: seed from the
# first image that came from the catalog feed, NOT the imageRole:'hero' stamp
# (which can be absent, letting the old ranking fall through to a UGC post).
VIDEO_SEED_FEED_ORDER=true
# Reject a feed-order candidate whose primary subject fills more than this
# fraction of the frame and take the next one; unmeasured media counts as
# acceptable so absent data never reorders the feed.
VIDEO_SEED_MAX_SUBJECT_FRACTION=0.6

# Generative reframe of video reference images (outpaint to target aspect).
REFRAME_ENABLED=true
REFRAME_OUTPAINT_MODEL=google/nano-banana-2/edit-developer
REFRAME_RESOLUTION=4k
REFRAME_SKIP_THRESHOLD=0.985
REFRAME_COST_USD=0.08
REFRAME_RATIO_TOLERANCE=0.05
REFRAME_MAX_SOURCE_BYTES=52428800
# BACK ON 2026-08-11 (owner) — the flip to generative outfill was reverted the
# same day, because it was aimed at the wrong cause.
#
# The letterbox bars observed on video were blamed on this pad. They were not
# from it: the pad only fires for isProductOnlyShot(media), and the affected
# seeds were on-model apparel shots, which are not product-only and never
# reached this branch. The real cause was VIDEO_LIFESTYLE_PROMPT capping the
# reference stack to a single unreframed seed (see that flag above).
#
# So the deterministic pad is restored, and with it the protection it exists
# for. c45ffa9e measured it over 20 generations on 8 real catalogue images: no
# Atlas model exposes a mask or pixel-passthrough (0 of 437), so outfill
# re-synthesises the whole canvas and FABRICATES MERCHANDISE — PELAGIC shorts
# returned as full-length trousers, an embroidered Soludos espadrille returned
# with a different arrangement of fruits than the shoe being sold. Turning that
# risk back on bought us nothing here.
REFRAME_PRODUCT_ONLY_PAD=true
REFRAME_BORDER_STD_MAX=8
REFRAME_PROMPT_STYLE=reframe
REFRAME_REDERIVE_STALE=true
# Strategy selector for the reframe path. 'outpaint-only' (default) preserves
# byte-identical behaviour with the generative outpaint ladder. 'crop-first'
# consults services/reframeStrategyChooser.js before spending on nano-banana:
# when Media.refinedProducts carries YOLO subject bboxes AND the union fits
# inside a target-aspect crop window on the source, ship a deterministic
# Cloudinary c_crop URL instead of paying to invent pixels. Fail-closed:
# any ambiguity (missing dims, missing YOLO output, non-Cloudinary source,
# subject too wide to fit) defers to the existing outpaint path.
REFRAME_STRATEGY=crop-first
# Additive prompt hardening for the 'reframe' outpaint variant. When true,
# appends SUBJECT IDENTITY (product name + label/logo protection), PHYSICAL
# ACCURACY (hands/faces/anatomy), and (when YOLO subjects touch a source
# frame edge) SOURCE-EDGE PROTECTION (do-not-invent-anatomy-above/below).
# When false — the DEFAULT — the base sentence is emitted byte-identically
# to pre-hardening; pinned by scripts/verifyReframePromptHardening.js.
# Never applied to REFRAME_PROMPT_STYLE='uncrop' (which is documented as
# verbatim-from-Expander and off-limits to mutation).
REFRAME_PROMPT_HARDENING=true
# Claim-loser wait: how many backoff reads (1s,2s,…,Ns) a reframe claim loser
# polls for the winner's asset before degrading to the deterministic crop.
# 26 ≈ 5m51s — covers a full cold 3-outpaint stage so a run racing the wizard
# prewarm gets the generative ref instead of a crop. Loser path never spends.
REFRAME_CLAIM_WAIT_ATTEMPTS=26
# Wizard-triggered 9:16 reference reframe prewarm (POST /api/ads/video-ref-prewarm).
# Warms buildReferenceImages cache before the paid video run so cold outpaints
# (~5 min, serialized on the -developer tier) happen while the operator is
# still in the wizard. Default ON; set false to disable without a redeploy.
VIDEO_REF_PREWARM_ENABLED=true
# Spend ceiling for the prewarm: products warmed per brand per rolling hour,
# per process. The route is authenticated, but nothing else stops a runaway
# client effect from warming a whole catalog (~3 outpaints per cold product).
# Refusing is always safe — the run reframes on demand instead.
VIDEO_REF_PREWARM_BRAND_HOURLY_CAP=24

# ── Concurrency (single source of truth: services/concurrency.js) ────
# Every knob below is either PROVIDER-IMPOSED (real external ceiling —
# env cannot raise above the documented max) or SELF-IMPOSED (our own
# throttle — raise when measured safe). Boot logs the resolved table
# via logConcurrencyConfig().
#
# WORKER_CONCURRENCY — SELF-IMPOSED. Parallel DetectRun/Job loops in the
#   worker process. I/O-bound; Mongo pool scales with it. Raised 5→8 on
#   2026-08-14 per the deferred YOLO scaling plan
#   (project_yolo_scaling_deferred.md step #1) after the 2026-08-13
#   analysis showed 25-product catalog bursts sitting behind the 5-slot
#   ceiling. Paired with yolo_microservice GUNICORN_WORKERS=2 +
#   OMP_NUM_THREADS=2 + TIMEOUT=100 (dashboard).
WORKER_CONCURRENCY=8
# RENDER_CONCURRENCY — SELF-IMPOSED. In-flight static/image ads per run.
#   File raised 4→8 on 2026-08-02 (image submits are unpaced —
#   atlasImageService; 8 concurrent openai/gpt-image-2/edit predictions
#   measured clean, 85s wall, ZERO 429s). That raise was NOT live in prod
#   for a day: the Render dashboard still pinned 4, and dotenv never
#   overrides an already-set var (index.js:1-5). Owner deleted the dashboard
#   pin on 2026-08-03 as part of the secrets-only cleanup, so the file's 8
#   became live then — a consequence of the migration, not a separate
#   tuning decision. See CLAUDE.md §4a.
#
#   RAISED 8→24 on 2026-08-04, owner-directed: "the renders should all go out
#   to atlas at the same time". At the time MAX_CREATIVES_PER_RUN was 20, so
#   24 made the gate non-binding for a full run. Since 2026-08-18 the run cap
#   is 1000 (effectively uncapped), so 24 is a WAVE SIZE — a big claim
#   renders in waves rather than all at once. This does NOT change spend: the
#   number of billable submits is fixed by the ad count, only the rate
#   changes.
#   Safe to do because image submits are UNPACED — pacedModelSubmit
#   (ATLAS_SUBMIT_SPACING_MS=1200) lives in atlasVideoService and gates VIDEO
#   only, so images were never drip-fed; 8 was purely this in-flight cap.
#   UNMEASURED ABOVE 8. The 2026-08-02 note records 8 concurrent
#   gpt-image-2/edit as clean with zero 429s; 24 is three times that and the
#   per-(team,model) RPS ceiling is unpublished. A 429 here is not a money
#   bug — isDefinite429 only replays on structured proof the request was
#   rejected before work began — but watch for 429 backoff in the logs on the
#   first full-size run and drop back if they appear.
RENDER_CONCURRENCY=24
# VEO_CONCURRENCY — SELF-IMPOSED. In-flight video ads per run. Since
#   2026-08-05 this is the SUBMIT+POLL half ONLY; Remotion titling has its
#   own permit below. Raised 1→4 (2026-08-02) as a deliberate probe, then
#   4→12 (2026-08-05) once the split made the number mean one thing.
#   Omni's RPS is unpublished and unmeasured (atlasVideoService notes
#   "Atlas publishes no RPS figure for this slug"). The old "stay at 1 —
#   provider 429s" justification belonged to (a) retired direct Google
#   Veo (commit 3a98cd4) and (b) Grok's real documented 1 RPS (commit
#   1492dca) — Grok is only the aspect-fallback model, not the primary
#   Omni path. No Omni 429 was ever recorded. Grok submits stay <=1 RPS via
#   per-slug pacedModelSubmit + GROK_MAX_RPS floor regardless of this value.
#   An Omni poll is ~2min of IDLE waiting (measured p50 117s / p99 247s), so
#   this half was never the expensive one. 12 is a WAVE SIZE under the
#   effectively-uncapped claim (MAX_CREATIVES_PER_RUN=1000 since 2026-08-18):
#   it bounds in-flight video submits/polls, not how many ads a run can claim.
#
#   RAISED 12→24 on 2026-08-20, owner-approved. Same reasoning as the
#   2026-08-05 split still holds: this half is submit+poll only, and an
#   Omni poll is ~2min of IDLE waiting (measured p50 117s / p99 247s) with
#   no Omni 429 ever recorded, so doubling the in-flight wave is low-risk —
#   it does not touch the memory-bound Remotion half. Grok is unaffected: it
#   is a separate aspect-fallback model paced independently via
#   pacedModelSubmit + the GROK_MAX_RPS floor, not by this knob. The one real
#   interaction: raising this WITHOUT also raising REMOTION_QUEUE_CONCURRENCY
#   would make titling a harder bottleneck — more masters finish submit+poll
#   per wave but queue longer for a titling slot — which is why both knobs
#   moved together this round. See REMOTION_QUEUE_CONCURRENCY below for why
#   that half only doubled (4→8) instead of matching this ratio.
VEO_CONCURRENCY=24
# VEO_TITLING_CONCURRENCY — SELF-IMPOSED. How many ads may be INSIDE the
#   titling call at once. 4 -> 48 (owner-directed 2026-08-13).
#   ⚠️ THIS IS NO LONGER THE MEMORY GUARD, and the old comment here was
#   wrong: it claimed to bound "simultaneous Remotion renders", but
#   remotionRenderService ran a concurrency-1 promise CHAIN, so exactly ONE
#   render ever happened no matter what this said. The other permit holders
#   waited. That is the entire 926s / 83%-idle titling tail measured on a
#   20-ad run — 13 renders strictly back to back.
#   What this actually bounds is the CHEAP prep half (buildMetaForAd, the
#   copy cascade, product/category reads, font resolution) — Mongo and disk,
#   not memory. So a wide value is safe, and 48 matches RENDER_CONCURRENCY in
#   being deliberately non-binding.
#   One real caveat: ~$0.02 of billable face-detection vision runs inside
#   this permit per ad, so a wide value bursts those concurrently. Same total
#   spend, higher instantaneous rate.
VEO_TITLING_CONCURRENCY=48
# REMOTION_QUEUE_CONCURRENCY — SELF-IMPOSED. ⚠️ THE REAL TITLING LIMIT, and
#   the number to move carefully. Simultaneous Remotion renders: a headless
#   Chrome page plus an ffmpeg 1080p encode, IN THE WEB PROCESS.
#   The failure mode is NOT a provider 429 — it is RSS exhaustion -> Render
#   autoscale (60% CPU+mem) -> process replacement -> a PAID Omni master
#   stranded mid-titling (~$1.00 each).
#   4 is a 4x win over the serial chain it replaces (926s tail -> ~230s
#   projected) and is not arbitrary: it is the value the combined
#   VEO_CONCURRENCY carried while it ran submit+poll AND Remotion in one
#   lane, so it is the only concurrency this process has actually survived.
#   It is still NOT an RSS measurement. Raise one step at a time against the
#   web service memory graph across a full run. One measured render = 76.2s
#   and 1080p is 2.25x the pixels of 720p.
#
#   RAISED 4→8 on 2026-08-20, owner-approved, alongside the VEO_CONCURRENCY
#   12→24 raise above. 16 was floated first but rejected: the paragraph
#   above is explicit that 4 "is the only concurrency this process has
#   actually survived" and is NOT an RSS measurement, and the failure mode
#   (RSS exhaustion -> Render autoscale -> process replacement) stridently
#   RESTARTS the web process — which strands any Omni master that was mid-
#   titling at that moment, and that master was already paid for (~$1.00
#   each). Doubling to 8 is one step, not a leap; it must be validated
#   against the web-service memory graph on a full run before going further.
#   Interaction with VEO_CONCURRENCY: leaving this at 4 while VEO_CONCURRENCY
#   went to 24 would have made titling a strictly harder bottleneck — more
#   masters land from submit+poll per wave with no extra titling slots to
#   drain them — so this moved in the same change, not independently.
#
#   REVERTED 8→4 on 2026-08-21. The validation that raise was made contingent
#   on has now happened, and 8 FAILED IT — in precisely the manner the
#   paragraph above predicted. This is that RSS measurement, from the Render
#   memory graph of a real 12-ad Pelagic video run (one Omni master + 11
#   derivatives), web service srv-d1vuktqli9vc73ft07ng:
#
#     10:33:00   0.33 GiB   idle, titling not yet started
#     10:33:30   3.88 GiB   titling begins
#     10:34:00   6.33 GiB
#     10:34:30   5.46 GiB
#     10:35:00   7.57 GiB
#     10:35:30   7.49 GiB
#     10:35:54   OOM KILL — server_failed, oomKilled, memoryLimit 8Gi
#     10:36:30   0.72 GiB   replacement instance booting
#
#   0.33 -> 7.57 GiB in two minutes, then death at the 8Gi ceiling. Implied
#   cost per concurrent slot is ~0.9 GiB ((7.57 - 0.33) / 8), so 8 slots want
#   ~7.2 GiB of an 8 GiB box — zero headroom — while 4 slots want ~3.6 GiB
#   over a 0.33 GiB baseline, which is ~4 GiB and is why 4 has survived.
#
#   The predicted collateral damage also landed exactly as written: the paid
#   Omni master (~$0.90 settled, CostLog atlas_video_render) was stranded
#   mid-titling, all 12 ads were left at status:'draft' with renderUrl still
#   pointing at the raw untitled 9:16 master, and video vision QC — which runs
#   after the titled upload — never executed on any of them. Recovery DID work
#   (titlingResumeService reclaimed the claims at TITLING_RESUME_STALE_MIN=15
#   and re-titled them for free, and the worker's reaper correctly SPARED the
#   run while that was in flight) so nothing was lost but ~20 minutes. The
#   money was not re-spent. That is the recovery path doing its job, not a
#   reason to keep a concurrency the process cannot survive.
#
#   Do not re-raise this without a memory graph showing real headroom at the
#   new value, on an instance size that has room for it. Raising the instance
#   RAM is the prerequisite for raising this number, not an alternative to it.
#   VEO_CONCURRENCY is deliberately LEFT at 24: that re-creates the titling
#   bottleneck the coupled raise was avoiding, which costs wall-clock only,
#   and slow strictly beats an OOM that strands paid masters.
#
#   ================= MEASURED ON ADGEN 2026-08-24 — 0.9 IS WRONG =================
#
#   The ~0.9 GiB/slot figure above is an UNDERSTATEMENT by ~2.2x. It was derived
#   as (7.57 - 0.33)/8, which silently assumes all 8 permits were rendering
#   concurrently at the instant of peak. They were not, so the divisor was too
#   large and the per-slot cost came out too cheap. Every decision built on 0.9
#   inherited that error.
#
#   FIRST REAL VIDEO RUN ON ADGEN (run_1787564306902_d3c1ca4a, 1 paid Omni
#   master + 11 free derives, all titling through this process):
#
#     09:44   0.10 GiB   idle
#     09:45   5.22 GiB
#     09:46   6.78 GiB
#     09:47   7.97 GiB   <- 99.6% of an 8 GiB limit
#     09:48   OOM KILL — Render server_failed, oomKilled, memoryLimit 8Gi,
#             instance -whg4h; instance -fllr9 died the same second with
#             nonZeroExit 137 (SIGKILL). TWO instances lost.
#
#     per-slot = (7.97 - 0.09) / 4 = ~1.97 GiB, not 0.90.
#
#   So 4 slots do NOT fit in 8 GiB. The 2026-08-21 kill was not an 8-slot
#   problem that 4 was safely under — 4 was always marginal and nobody had run
#   it here to find out, because until today the video path died upstream at
#   import (veoPrepareStoryboard was undefined).
#
#   Note what autoscaling did: it scaled 2 -> 3 -> 4 instances on the way up
#   (09:44:29 and 09:48:00 autoscaling_started) and that made things WORSE, not
#   better — each new instance runs its own 4 Remotion slots and hits the same
#   per-instance ceiling. Instance COUNT cannot fix a single-process RSS blowup;
#   only instance SIZE or this number can.
#
#   Budget against the MEASURED 1.97 GiB/slot on the 8 GiB pro_plus box:
#     1 slot -> ~2.1 GiB (26%)   OK
#     2 slots-> ~4.0 GiB (50%)   OK, and stays under the 60% autoscale trigger
#     3 slots-> ~6.0 GiB (75%)   over the trigger, thrashes autoscale
#     4 slots-> ~8.0 GiB (100%)  OOM — observed above
#
#   Set to 2. A live dashboard override REMOTION_QUEUE_CONCURRENCY=2 was applied
#   immediately when the kill was detected; this commit makes the committed
#   default agree with it so a fresh boot does not inherit 4.
#
#   To raise: measure again on a real video run and keep peak under 60%, or move
#   to a bigger instance first. Do not restore 4 on an 8 GiB box — that is the
#   configuration that was just observed to die.
REMOTION_QUEUE_CONCURRENCY=2
#
# REMOTION_TIMEOUT_MS — Remotion's INTERNAL delayRender() timeout, passed
# as timeoutInMilliseconds to selectComposition / renderMedia / renderStill.
# This is NOT a whole-render bound. Remotion 4.0.495 documents it as "how
# long the render may take to resolve all delayRender() calls" (package
# default 30000). 180000 is the historical value and is generous for a hung
# delayRender. It is NOT the child-process SIGKILL budget — that is
# REMOTION_CHILD_TIMEOUT_MS below. #8 (c00e17d) reused this number as both;
# a 180s wall-clock then sat inside the measured render tail and failed 25%
# of a paid Meta batch (run_1787575090320_db5a5d96).
REMOTION_TIMEOUT_MS=180000
#
# REMOTION_CHILD_TIMEOUT_MS — parent supervisor WALL-CLOCK kill of
# remotionRender.child.js. Distinct from REMOTION_TIMEOUT_MS. Timer starts
# at spawn, AFTER a REMOTION_QUEUE_CONCURRENCY slot is acquired (queue wait
# is not counted). Covers the whole child lifetime: re-bundle, browser,
# plate download/scan, selectComposition, renderMedia, process.exit.
#
# Chosen 480000ms (8 min) against a measured 62-asset distribution:
#   mean 89s / p95 158s / max 380s
#   concurrency 2, 1.97 GiB/slot
# 480s > 380s max → admits 100% of that sample, with 26% slack above the
# observed max for in-child work that is not renderMs (each child
# re-bundles) and for conc=2 CPU contention that pushed wall-clock UP
# relative to when 180s was chosen. 180s sat INSIDE the tail (p95 158,
# max 380). Still finite: a wedged Chrome/ffmpeg is SIGKILL'd at 8 min so
# it cannot hold a queue slot forever. Must stay under the titling-
# heartbeat lifetime cap (live 60.8 min at MAX_INFLIGHT=32 / conc=2;
# formula floor 10 min) — 480s is under both as a PER-CHILD bound, so a
# hung in-slot child is SIGKILL'd and the slot frees before that ad's
# beat dies. A full 32-inflight pile-up of 480s waves is 128 min and
# DOES exceed 60.8 min; the heartbeat formula still uses 76s (3x = 228s
# per wave) which is already below the measured 380s max. That cap is a
# different PR — do not "fix" it by dropping this bound back under 380s
# (tonight's bug) or by raising the beat here. Do not set to Infinity or
# leave unset without a finite fallback.
REMOTION_CHILD_TIMEOUT_MS=480000
# MAX_CREATIVES_PER_RUN — SELF-IMPOSED. Ads claimed into one CampaignRun.
#   Effectively uncapped (owner 2026-08-18: "immediately remove the cap").
#   1000 is a sanity ceiling, not a product cap — enforced by
#   services/concurrency.js SPEC (file + code default must move in lockstep,
#   CLAUDE.md §4a). History: 20 starved every static ad on Everything runs
#   once PR #197 tripled per-product video mints (video tier drains first,
#   21 videos/product filled the whole claim). RENDER_CONCURRENCY /
#   VEO_CONCURRENCY are now wave sizes, so a big claim renders in waves
#   rather than all at once. Note: ALERT_HOURLY_SPEND_USD=25 can now be
#   tripped by one large multi-product run (alert-only, not a blocker).
MAX_CREATIVES_PER_RUN=1000
# ATLAS_SUBMIT_SPACING_MS — SELF-IMPOSED. Start-to-start spacing for
#   same-model VIDEO submits only (pacedModelSubmit). Default 1200ms.
#   Do NOT lower casually. Image submits are unpaced.
ATLAS_SUBMIT_SPACING_MS=1200
# GROK_MAX_RPS — PROVIDER-IMPOSED. Grok Imagine documented 1 RPS.
#   Env may LOWER (e.g. 0.5) but cannot raise above 1. Derives
#   GROK_MIN_SUBMIT_SPACING_MS = ceil(1000/RPS) applied to xai/grok-*
#   slugs even if ATLAS_SUBMIT_SPACING_MS is 0.
GROK_MAX_RPS=1
# CAMPAIGN_BRIEF_CONCURRENCY — SELF-IMPOSED. LLM brief derivations after
#   campaign sync (was hardcoded 3).
CAMPAIGN_BRIEF_CONCURRENCY=3
# AI_LAYOUT_COMBO_CONCURRENCY — SELF-IMPOSED. Layout-studio image gens
#   (was hardcoded 3).
AI_LAYOUT_COMBO_CONCURRENCY=3
# CLOUDINARY_DELETE_CONCURRENCY — SELF-IMPOSED. Parallel Cloudinary
#   destroy in deleteManyFromCloudinary (was hardcoded 4). Free tier
#   ~500 ops/hr; paid tiers allow higher.
CLOUDINARY_DELETE_CONCURRENCY=4
# CATALOG_MATERIALIZE_CONCURRENCY — SELF-IMPOSED. Parallel Cloudinary
#   uploads in catalogMaterializeDrainService's bulk hero backfill (new
#   2026-08-19). Same account-level Cloudinary quota as
#   CLOUDINARY_DELETE_CONCURRENCY above, same default. No vision/LLM
#   spend rides on this path.
CATALOG_MATERIALIZE_CONCURRENCY=4
# CATEGORY_INFERENCE_DOMAIN_CONCURRENCY — SELF-IMPOSED. Per-host scrape
#   cap for category inference (was hardcoded 3).
CATEGORY_INFERENCE_DOMAIN_CONCURRENCY=3
# CATEGORY_INFERENCE_BATCH_CONCURRENCY — SELF-IMPOSED. Global inferBatch
#   pool + catalog/ingest call sites (was hardcoded 6 at call sites).
CATEGORY_INFERENCE_BATCH_CONCURRENCY=6
# META_PUSH_CONCURRENCY — SELF-IMPOSED. Meta Graph ad-publish fan-out
#   (was hardcoded 3).
META_PUSH_CONCURRENCY=3
# VOICE_SWEEP_CONCURRENCY — SELF-IMPOSED. Brand-voice refresh pool in
#   the scheduled sweep (was hardcoded 2).
VOICE_SWEEP_CONCURRENCY=2

# ── Ingest tuning ────────────────────────────────────────────────────
APIFY_IG_ACTOR=apify/instagram-scraper
APIFY_IG_LIMIT=30
APIFY_SHOPIFY_ACTOR=webdatalabs/shopify-product-scraper
APIFY_SHOPIFY_LIMIT=50
APIFY_PROXY_GROUP=RESIDENTIAL
POST_FETCH_LIMIT=50
CATALOG_SYNC_MAX_ITEMS=250
CATALOG_VISUAL_MATCH_MAX_IMAGES=1
# CATALOG_MAX_ADDITIONAL_IMAGES — STORAGE cap on CatalogProduct.additionalImages
# (URL strings only; free). Shared by Shopify-direct and generic-sitemap ingest.
# Deliberately higher than catalogProductDetectService.MAX_ALT_IMAGES (12), which
# is the materialisation spend gate (Cloudinary + Media + detect). Raising this
# does NOT raise spend. Raised from the old hardcodes (Shopify slice(1,9)=8 alts,
# generic slice(1,5)=4 alts) after measuring pb5star.com 2026-08-10: 30/99
# products had >9 images and 76 distinct alts were silently discarded. Default
# 20 sits above that store's observed max (15). The ASSIGNMENT lives with the
# shared-module docs further down (search CATALOG_MAX_ADDITIONAL_IMAGES) — do not
# re-add it here: dotenv lets the LAST occurrence win, so a second assignment
# silently overrode this one with 12 until it was caught.
# CATALOG_MAX_ALT_IMAGES — MATERIALISATION cap (catalogProductDetectService):
# how many alts get mirrored to Cloudinary + a Media row. This one COSTS
# money; the storage cap above does not. Raised 12 → 20 on 2026-08-10 by
# owner directive ("I don't mind spending the money to mirror images in order
# to ensure there is stability") — an un-mirrored merchant URL breaks when the
# store rotates its CDN or unpublishes the asset, so mirroring is what makes a
# catalog image durable. Marginal cost is Cloudinary storage/bandwidth, NOT AI
# spend: detect stays deferred (CATALOG_DETECT_PRECOMPUTE=false), so extra alts
# do not each trigger a paid detect run. Keep this ≤ the storage cap — mirroring
# more than we store is meaningless. Separate knob on purpose: never fold the
# two into one var, or a free storage bump silently becomes a paid one.
CATALOG_MAX_ALT_IMAGES=20

# CATALOG_IMAGE_UPGRADE_ENABLED — defence-in-depth against storing a CDN
# THUMBNAIL as CatalogProduct.imageUrl (the default ad seed). Measured live
# on marinelayer.com 2026-08-11 (Shopify + Cloudflare, same product photo):
#   products.json → ...Final-Web.jpg?v=…            757,341 bytes
#   JSON-LD PDP   → ...Final-Web_small.jpg?v=…        3,820 bytes  (198× smaller)
# The hero image feeds billable gpt-image-2 generations under
# CATALOG_FEED_ORDER_SEEDING / preferFirstCatalogImage — a 3.8KB thumbnail
# is garbage-in, paid-garbage-out. Auto-detect already routes true Shopify
# to products.json (originals); this flag covers JSON-LD/OG fallthrough
# (CF-blocked Shopify, non-Shopify stores that emit resized URLs).
# HOW: services/imageUrlUpgrade.js strips a known Shopify size token
# (_small/_medium/_1024x1024/…) or WP -{W}x{H} suffix, PRESERVES ?v=, then
# HEAD-checks the candidate. On any non-2xx / network error / timeout it
# FALLS BACK to the original (a working thumbnail beats a 404 — a file
# can legitimately be named photo_large.jpg). Memoised per-URL within a
# resolve; capped by CATALOG_IMAGE_UPGRADE_MAX_CHECKS so a huge catalog
# does not pay unbounded HEADs. Flag-off = byte-identical prior path
# (no upgrades, no HEADs). Default ON — the current behaviour stores the
# thumbnail as the billable seed.
CATALOG_IMAGE_UPGRADE_ENABLED=true
# Cap on HEAD (or ranged-GET) verification requests per catalog resolve.
# Past this, further upgrade candidates are LEFT UN-UPGRADED rather than
# swapped without verification. Default 500 covers a full medium catalog
# with room; distinct URLs only (memo hits do not count).
CATALOG_IMAGE_UPGRADE_MAX_CHECKS=500

# ── Generic catalog scraper (sitemap + JSON-LD) ──────────────────────
# GENERIC_CATALOG_ENABLED kill-switch (default on unless 'false').
# GENERIC_CATALOG_LIMIT / _MAX_SITEMAP_URLS bound a first sync's cost.
# GENERIC_CATALOG_PDP_CONCURRENCY: parallel product-page fetches (the scan
#   still respects each host's crawl-delay + httpScrapeClient's min-gap).
# Wall-clock budgets sit INSIDE progressService.MAX_RUN_MS (4h) — that
# value only stops the progress heartbeat; these actually break the scan
# loops so a large/hostile site cannot grind ~83 min while the UI stalls.
# Non-finite / ≤0 → unbounded (safety: a missing env must not expire every run).
GENERIC_CATALOG_ENABLED=true
# GENERIC_CATALOG_AUTODETECT — sense Shopify (etc.) from the homepage +
# robots.txt the resolver already fetches, then climb the Shopify access
# ladder when the store is Shopify. WHY (measured 2026-08-10): every brand
# on method=generic-sitemap that is actually Shopify stored ZERO alt images
# — PB5Star 100 products / 0 alts, Fellow 9 / 0. Shopify's JSON-LD
# Product.image is a single featured image; /products.json carries the full
# gallery (pb5star mean 7.91, max 15). Living Spaces (not Shopify) stays on
# sitemap+JSON-LD and must not regress. Flag-off restores byte-identical
# prior behaviour: no homepage fetch, no fingerprint, no new result keys.
# Default true — no production brand depends on the broken zero-alt output.
GENERIC_CATALOG_AUTODETECT=true
GENERIC_CATALOG_LIMIT=10000
GENERIC_CATALOG_MAX_SITEMAP_URLS=20000
GENERIC_CATALOG_PDP_CONCURRENCY=5
GENERIC_CATALOG_TOTAL_BUDGET_MS=1500000   # 25 min wall-clock for discovery + sitemap walk + PDP scan
GENERIC_CATALOG_SITEMAP_BUDGET_MS=600000  # 10 min rung for sitemap walk (clamped to total remaining)
GENERIC_CATALOG_UPSERT_BUDGET_MS=300000   # 5 min for CatalogProduct upserts — separate clock from the network scan
GENERIC_CATALOG_FAIL_ON_ZERO=true         # a run that attempted sources and ingested nothing must not report success
# Category options from sitemap URL path segments (no PDP fetches). Lets an
# operator narrow a large catalog (e.g. fanatics ~800k) before the scan.
# Flag-off restores a byte-identical resolver result (no new keys).
GENERIC_CATALOG_CATEGORY_OPTIONS=true      # derive category options from sitemap URLs (no PDP fetches)
GENERIC_CATALOG_CATEGORY_PROMPT_MIN=500    # above this candidate count, suggest narrowing by category
GENERIC_CATALOG_CATEGORY_MIN_COUNT=25      # ignore categories with fewer than this many products
GENERIC_CATALOG_CATEGORY_MAX_OPTIONS=40    # cap the option list handed to an operator
HTTP_SCRAPE_MIN_GAP_MS=250

# ── Browser session rung (last resort after cheap HTTP fails) ────────
# WHY (measured 2026-08-10): ubeauty.com yields 0 products — Shopify
# behind a Cloudflare managed challenge. /robots.txt returns 200, but
# /products.json, /collections/all, /sitemap.xml and /sitemap_products_1.xml
# all return 403 with cf-mitigated:challenge. A real browser clears the
# interstitial; an in-page same-origin fetch('/products.json?limit=250')
# then returns HTTP 200 and all 103 products (page=2 is empty — complete).
# HttpOnly cf_clearance/__cf_bm cannot be read via document.cookie — harvest
# uses page.cookies(origin) (CDP Network.getCookies) and pins that UA on
# every HTTP replay (CF partly binds clearance to User-Agent).
#
# MEMORY: Chrome launches ONLY when the cheap path already failed with a
# browser-fixable block (or Shopify fallthrough / zero sitemap candidates
# while robots was reachable). Most syncs never start a browser. One
# process-wide singleton (headlessBrowserClient) shared with review capture.
# RENDER_GENERIC_ENABLED is independent of SHOPIFY_HEADLESS_RENDER (still
# default off for the older Shopify-only full render path).
RENDER_GENERIC_ENABLED=true
HEADLESS_STEALTH_ENABLED=true
SCRAPE_SESSION_REUSE_ENABLED=true
# Cloudflare clearance TTL is UNDOCUMENTED — 10 min is a conservative guess
# so a stale cookie is dropped rather than endlessly re-challenged.
SCRAPE_SESSION_TTL_MS=600000
# Cap re-harvests per host so a site that blocks even a fresh browser
# session falls through instead of relaunching Chrome forever.
SCRAPE_SESSION_MAX_REFRESH=3

# ── Catalog detect + enrichment (deferred / gap-fill; see docs) ──────
# CATALOG_DETECT_PRECOMPUTE=false → per-product detect (crops/overlay
#   zones/ad-readiness) is deferred to ad-generation time instead of
#   running for the whole catalog at sync time. Set true to restore eager
#   whole-catalog precompute.
# CATALOG_ENRICHMENT_* bound the auto review gap-fill + the user-actuated
#   "Enrich" (cross-seller + web-review) path.
CATALOG_DETECT_PRECOMPUTE=false
CATALOG_ENRICHMENT_CONCURRENCY=6
CATALOG_ENRICHMENT_MAX_PER_RUN=500

# CATALOG_MAX_ADDITIONAL_IMAGES — per-product ADDITIONAL images kept at ingest
#   (the hero / imageUrl is separate, so total = 1 + this). ONE number shared by
#   every catalog writer — generic JSON-LD resolver, generic upsert, Shopify
#   public, and Meta catalog sync — via services/catalogImageLimits.js (a
#   deliberately zero-dependency module, so importing it never drags the scrape
#   stack into the Meta sync path).
#   WHY 12: the four paths previously disagreed (generic 4, Shopify 8, Meta 8)
#   while catalogProductDetectService.MAX_ALT_IMAGES already materialized up to
#   12 — so the generic path was discarding images the pipeline could use. PDP
#   galleries conventionally lead with the packshot and put lifestyle shots
#   LATER, which is exactly what the tight cap was cutting off.
#   Must stay in lockstep with MAX_ALT_IMAGES — storing more than detect
#   materializes only wastes DB/bandwidth. Clamp never allows 0/negative.
#   Fenced by scripts/verifyCatalogImageCaps.js.
#   RAISED 12 -> 20 (owner, 2026-08-11): marinelayer.com products carry up to 15
#   images, so 12 truncated the richest SKUs. MAX_ALT_IMAGES moved to 20 in the
#   same breath to keep the lockstep — see CATALOG_MAX_ALT_IMAGES above, which is
#   the PAID mirroring half of this pair.
CATALOG_MAX_ADDITIONAL_IMAGES=20

# CATALOG_SHOT_HEURISTIC_ENABLED — zero-cost packshot-vs-lifestyle classifier
#   (services/imageShotHeuristicService.js). Pure sharp on the buffer the detect
#   pipeline already downloaded: border-ring uniformity + global entropy +
#   centre-vs-border contrast, ~7-9ms/image. No LLM, no network, no billable
#   anything — hence default ON. Only the explicit string "false" disables it.
#   Writes Media.technicalInsights.shotStyle/Confidence/Metrics ONLY; it never
#   touches classification.shotType, which stays LLM-owned so the two can be
#   compared (see scripts/calibrateShotHeuristic.js for the agreement matrix).
#   THRESHOLDS ARE UNTUNED starting points — calibrate before trusting them.
#   A failure returns null and can never fail a DetectRun.
CATALOG_SHOT_HEURISTIC_ENABLED=true

# ── Ingest-time shot classification (services/ingestShotClassifyService.js) ──
# WHY THIS EXISTS: the classifier above is FREE (pure sharp), but it used to run
#   only inside a DetectRun, which also fires a billable gpt-4.1 subjects-text
#   call + a YOLO call per image. That coupling was accidental — the classifier
#   needs image BYTES, and the detect pipeline's download was the only place
#   bytes existed in Node (materializeImage hands Cloudinary a URL and
#   CLOUDINARY does the fetch, so pixels never touch us). This path fetches the
#   bytes itself at ingest, so every catalog image is classified for ~free and
#   the expensive vision pass becomes a deliberate narrow choice instead of
#   something that scales with image count.
#
# SAFETY — the product upsert NEVER waits on this. Classification runs as a
#   POST-LOOP pass after every product is already persisted. Two independent
#   adversarial reviews found the original design awaited it inside the upsert
#   loop with unbounded DNS, which meant one hung resolver silently truncated a
#   brand's catalog — worst on a NEW merchant's first sync. Restructured so that
#   whole bug class is impossible. Skip counts are logged from a `finally`, so a
#   truncated run can never read as "classified everything".
#
# SSRF: this fetches URLs harvested from arbitrary third-party product pages, so
#   it validates post-DNS (a hostname resolving to a private address is
#   rejected) and PINS the socket to the validated address via a custom lookup,
#   closing the DNS-rebinding window. Redirects use `redirect: 'manual'` and every
#   hop is re-validated and re-pinned. It deliberately does NOT use
#   httpScrapeClient, which follows redirects with no hop validation.
#
#   _ENABLED       default true — free of LLM cost. Only the string "false"
#                  disables. This is the kill switch if a sync ever looks slow.
#   _CONCURRENCY   6, mirroring CATALOG_ENRICHMENT_CONCURRENCY.
#   _TIMEOUT_MS    5000 — ONE deadline per URL covering DNS + EVERY redirect hop
#                  + body read. Deliberately not re-armed per hop, so a 6-hop
#                  redirect chain cannot stack 6x the timeout.
#   _MAX_BYTES     5000000 — refuse to download an oversized image.
#   _BUDGET_MS     120000 — per-SYNC (not per-product) wall-clock ceiling. When
#                  it elapses, remaining images defer to the detect-time
#                  fallback and the skip count is logged.
# Fenced by scripts/verifyIngestShotClassify.js, incl. a hung-DNS regression test.
CATALOG_INGEST_SHOT_CLASSIFY_ENABLED=true
CATALOG_INGEST_SHOT_CLASSIFY_CONCURRENCY=6
CATALOG_INGEST_SHOT_CLASSIFY_TIMEOUT_MS=5000
CATALOG_INGEST_SHOT_CLASSIFY_MAX_BYTES=5000000
CATALOG_INGEST_SHOT_CLASSIFY_BUDGET_MS=120000

# ── Public identifiers / URLs (NOT secrets) ──────────────────────────
#
# The five *_URL / *_URI values below are STAGING defaults, baked into
# the file so single-env deploys work without any dashboard vars set.
# PROD deploys MUST override all five in the Render dashboard (per §4a
# precedence rules) — otherwise Meta / Google OAuth callbacks route
# through the staging backend and the prod flow is dead-on-arrival.
# See server/docs/PROD_DEPLOY.md for the flip-day checklist.
CLOUDINARY_CLOUD_NAME=reach-social-prod
FRONTEND_URLS=https://liquidretail.netlify.app,https://rsvite.netlify.app,https://staging.reach-social.io
GOOGLE_CLIENT_ID=267853912881-bsuu6jvale0kn99i41uora4n2t9t7rkd.apps.googleusercontent.com
GOOGLE_CALLBACK_URL=https://liquidretail-backend.onrender.com/auth/google/callback
GOOGLE_ADS_CLIENT_ID=1002025338708-06a7p49aet9l2fhu4dnnh0tnnnvh6ehl.apps.googleusercontent.com
GOOGLE_ADS_REDIRECT_URI=https://liquidretail-backend.onrender.com/api/integrations/google-ads/callback
META_APP_ID=833156162601293
META_ADS_REDIRECT_URI=https://liquidretail-backend.onrender.com/api/integrations/meta-ads/callback
META_REDIRECT_URI=https://liquidretail-backend.onrender.com/api/integrations/instagram/callback
# Meta Graph API version. Blank = services/metaApiVersion.js default (v26.0,
# verified 2026-08-11 against Meta's changelog). Code owns the value so there is
# exactly one place to bump it; this key exists to allow a staged migration.
# Malformed values fall back to that default + fatal alert (fail-open); they
# must NEVER take down web/worker boot.
#
# REVIEW CADENCE — this is not set-and-forget. The MARKETING API (every
# money-facing call: campaigns, ads, adimages, advideos, insights) guarantees
# only ~90 DAYS of support past the next release, NOT the ~2 years the Graph API
# core gets. So a version can go stale within one quarter. Expired versions do
# not error — Meta silently routes them to the next oldest usable version — so
# nothing here will fail loudly on your behalf. Check quarterly against
# https://developers.facebook.com/docs/graph-api/changelog/ and the
# KNOWN_EXPIRED tripwire in services/metaApiVersion.js.
META_API_VERSION=


# Env override for the YOLO Docker service URL. Unset → falls back to
# the pre-split hard-coded value inside services/yoloService.js
# (yolo-microservice.onrender.com). Prod dashboard MUST set this to
# the prod YOLO service URL; staging leaves it unset to inherit the
# fallback.
# YOLO_SERVICE_URL=https://yolo-microservice.onrender.com

# ── A3 — YOLO input downscale (2026-08-13) ─────────────────────────────
# Measured over 200 recent runs: 23% failed with `yoloFailed=true` because
# YOLO wall clock exceeded the 120s axios client timeout (p90=136s,
# p99=241s). Downscaling the buffer from ~2000px → 1600px before submit
# halves tile count (12→6) and drops per-image latency well inside the
# timeout, at negligible small-object recall cost on catalog product
# plates. Default ON; flip false to restore pre-fix behaviour.
YOLO_DOWNSCALE_ENABLED=true
YOLO_MAX_INPUT_WIDTH=1600

# ── C1 — visual-only catalog match fallback (2026-08-13) ───────────────
# When the text-catalog match returns zero candidates (UGC lifestyle
# shots typically have no OCR + captions with no SKU tokens), the
# fallback pulls up to CATALOG_VISUAL_ONLY_TOPK category-scoped
# CatalogProducts and asks Gemini Vision to score the refined crop
# against each. K=8 × ~$0.0015 per call × ~20 UGC runs/day ≈ $0.24/day.
CATALOG_VISUAL_ONLY_TOPK=8

# ── D1 / D2 — SKU-linkage fuzzy tier + visual tiebreak (2026-08-13) ───
# `ensureCatalogProductForMatch` used to have three linkage tiers
# (externalId → normalizedTitle exact → subset). Measured over 31
# `product_match` outcomes, only 4 (13%) linked to a catalog row. The
# fuzzy tier catches the middle band via token-Jaccard overlap. Guards:
# brand-loose-match required, score >= FUZZY_MIN_SCORE, shared >= 3.
# When multiple fuzzy candidates score within FUZZY_TIE_BAND of the
# leader, the visual score (already computed by C1) tiebreaks — capped
# at FUZZY_VISUAL_MAX comparisons per match.
SKU_LINK_FUZZY_ENABLED=true
SKU_LINK_FUZZY_MIN_SCORE=0.6
SKU_LINK_FUZZY_TIE_BAND=0.1
SKU_LINK_FUZZY_VISUAL_MAX=4

# ── R1 — reasoner threshold alignment (2026-08-17) ─────────────────────
# Measured 2026-08-13: 126/166 UGC matches landed in brand_match. Root
# cause was the reasoner's own guide naming 0.70-0.89 "high" while
# productMatchService required >= 0.80 for product_match, silently
# demoting 0.70-0.79 rows to product_category (or worse to brand_match
# when the URL guard fired). REASONER_ALIGNED_BANDS=true (default)
# uses REASONER_PRODUCT_MATCH_MIN=0.70, REASONER_CATEGORY_LOWER=0.49,
# REASONER_CATEGORY_UPPER=0.69. Set false to restore the pre-2026-08-17
# HIGH_CONFIDENCE=0.80 threshold for reasoner cert only (dual-engine +
# catalog thresholds unchanged either way).
REASONER_ALIGNED_BANDS=true

# ── T1 / T2 — catalog text-scorer overhaul (2026-08-17) ────────────────
# findCatalogMatchByText rewritten to:
#   - use min(|signal|,|haystack|) as the overlap denominator instead
#     of |signal|, so a 12-token caption isn't punished for being long
#   - expand `@brandhandle` in captions/comments to spaced brand tokens
#   - expand tokens with a small apparel-first synonym table so
#     sweater↔pullover↔knit and jacket↔chore↔shacket count as shared
#   - raise the category-match boost 0.10 → 0.20
#   - drop the score floor 0.30 → 0.25 now that scoring is calibrated
# Kill switch SKU_TEXT_SYNONYMS_ENABLED=false disables synonym
# expansion. Floor and boost are env-tunable.
SKU_TEXT_SYNONYMS_ENABLED=true
SKU_TEXT_SCORE_FLOOR=0.25
SKU_TEXT_CATEGORY_BOOST=0.20

# ── V1 / V2 / V3 — matcher quality follow-ups (2026-08-17) ─────────────
# From live Allbirds test: (a) visual matcher hallucinated a
# jeans-crop → sneaker-row match at score 0.95; (b) 10 refined products
# collapsed to one catalog row because the coarse-enum pool mixed
# sneakers + jeans + shirts; (c) detect-identified ghost rows sometimes
# outrank synced siblings on tie scores.
#
# V1 — inline prompt guard in visualCatalogMatchService (no env; if
# quality regresses, revert commit).
# V2 — sub-class pool filter in findCatalogMatchByText. When refined.
# label maps to a synonym group (jacket, shoe, jeans, etc.), keep only
# rows whose title+description also contain a same-group token. Falls
# back to broader pool when the filter removes everything.
SKU_SUB_CLASS_FILTER_ENABLED=true
# V3 — synced-preferred tiebreak at catalog-first winner selection.
# When multiple candidates score within TIE_BAND of the leader and the
# leader is detect-identified but a synced sibling qualifies, promote
# the synced one. Mirrors the D1 tiebreak already in
# ensureCatalogProductForMatch.
CATALOG_FIRST_PREFER_SYNCED=true
SKU_CATALOG_FIRST_TIE_BAND=0.05

# ── T3 — semantic embedding tier (2026-08-17) ──────────────────────────
# Token overlap misses paraphrases the synonym list doesn't cover.
# When enabled, findCatalogMatchByText fetches an embedding for the
# combined signal blob and cosine-scores it against each candidate
# row's title embedding (persisted on CatalogProduct.titleEmbedding).
# Final score = max(tokenScore, cosine * SKU_TEXT_EMBEDDING_WEIGHT).
#
# Cost floor: openai/text-embedding-3-small ≈ $0.02 per 1M tokens.
# TOPN=30 rows × ~50 tokens each + 100-token signal × 20 UGC runs/day
# ≈ 1M tokens/mo ≈ $0.02/mo per brand. Persisted embeddings amortize:
# each product pays once until its title/description changes.
#
# Default off until measured live. Turn on with:
#   CATALOG_TEXT_EMBEDDING_ENABLED=true
CATALOG_TEXT_EMBEDDING_ENABLED=false
TEXT_EMBEDDING_MODEL=openai/text-embedding-3-small
SKU_TEXT_EMBEDDING_TOPN=30
SKU_TEXT_EMBEDDING_FLOOR=0.55
SKU_TEXT_EMBEDDING_WEIGHT=0.85
JIRA_BASE_URL=https://reach-egami-team.atlassian.net
JIRA_EMAIL=decastro.mark85@gmail.com
SALES_DEMOS_ADMINS=mark@reach-social.io,brian@egami.tv,nick@reach-social.io
# Cross-tenant super-admins (services/superAdminService.js). Comma-separated,
# case-insensitive. On every Google login the passport upsert re-stamps
# User.isSuperAdmin from this list, so add/remove without redeploying data.
# Super-admins get synthetic 'owner' membership to every Advertiser (workspace
# switcher shows all) and see admin-only nav (Sales Demos). Does NOT unscope
# money paths — Brand/Ad/spend queries still filter by req.advertiserId.
# Also auto-qualify as SALES_DEMOS_ADMINS bootstrappers (isAllowedBootstrapper
# ORs the two lists) so a new super-admin only needs one edit here.
SUPER_ADMIN_EMAILS=mark@reach-social.io,brian@egami.tv,nick@reach-social.io

# Ad-gen microservice handoff (Phase 1a — services/adgenBridge.js). When true,
# runRenderLoop returns early and the liquidretail_adgen renderer picks up the
# claimed ads via its atomic claim on {status:'rendering', claimedByWorker:null}.
# Default false — backend runs the in-process render loop as it has since day 1.
# Flip to true only when the adgen service is actually deployed AND you want
# it to take the work. Toggling this alone with no adgen deployed strands ads
# in status='rendering' until the 15-min reaper requeues them.
ADGEN_RENDERER_ENABLED=false
SHOPIFY_STORE_DOMAIN=wmkggm-zu.myshopify.com

# ── Operational alerting → Slack (services/alertService.js) ───────────
# ONE secret, and it lives in Render env only, deliberately absent here:
#   SLACK_BOT_TOKEN
#
# The CHANNELS are not secret — a channel id or #name discloses nothing and
# is useless without the token — so they live here with every other
# non-secret public id, and changing where alerts go is a committed,
# reviewable diff instead of an untracked dashboard edit. Real env still
# wins over this file (index.js loads env first, dotenv never overrides an
# already-set var), so a single service can still be pointed elsewhere from
# the Render dashboard without a deploy.
#
# Alerts stay silently disabled until SLACK_BOT_TOKEN is set, so shipping
# these channel values changes nothing on its own.
SLACK_ALERT_CHANNEL=C0BMMDA3MFE
# Separate channel for `fatal` only; falls back to the main one if blank.
SLACK_ALERT_CHANNEL_FATAL=C0BM2BG6M71
# Per-run live feed (services/runFeedService.js). One parent message per
# CampaignRun (chat.update'd on a throttle = the live status screen), with
# the full chronological event log as threaded replies batched on a short
# interval. Completely inert without SLACK_BOT_TOKEN. Poll ticks are
# filtered from the thread; they only refresh the parent's "now:" line.
SLACK_ALERT_CHANNEL_STATUS=C0BMMD5AN84
# RUN_FEED_ENABLED — master switch. Default ON when the channel is set;
#   set false to mute the feed without unsetting the channel.
# RUN_FEED_PARENT_THROTTLE_MS — min ms between chat.update of the parent
#   (live counts / stages / elapsed). Final finish always flushes.
# RUN_FEED_THREAD_FLUSH_MS — detached interval that drains the ring buffer
#   into threaded posts. All Slack I/O happens here, never on a render path.
# RUN_FEED_RING_SIZE — fixed per-run event buffer. When full, DROP OLDEST
#   and count the drops; the next post reports "(N events dropped)".
RUN_FEED_ENABLED=true
RUN_FEED_PARENT_THROTTLE_MS=10000
RUN_FEED_THREAD_FLUSH_MS=2000
RUN_FEED_RING_SIZE=200
#
# ALERT_MIN_LEVEL — info | warn | error | fatal. 'warn' mutes the
#   per-boot "started" line; set 'info' to watch instance restarts live
#   (Render autoscaling replaces the web instance on its own, and each
#   replacement kills any in-flight render loop).
# ALERT_DEDUPE_WINDOW_MIN — a given alert key sends at most once per
#   window; repeats are counted and folded into the next delivery.
# ALERT_RATE_LIMIT_MAX — hard ceiling on messages per minute.
# ALERT_WATCHDOG_INTERVAL_MIN — health-sweep cadence in the worker.
# ALERT_RENDERING_STALE_MIN — must stay BELOW REAP_STALE_MIN (15) so a
#   wedged render is reported before the reaper rewrites the evidence.
# ALERT_RUN_STALE_MIN — AGE noise filter for the stalled-run alert.
#   A 20-ad video batch at VEO_CONCURRENCY=4 is far shorter than the old
#   ~25-35min serial (VEO=1) path; 45m still clears it. Not the trigger.
# ALERT_RUN_SILENCE_MIN — SILENCE trigger for the stalled-run alert.
#   MUST stay strictly below REAP_STALE_MIN (15). The reaper already
#   flips { status:'running', updatedAt < 15m } to failed, so a silence
#   threshold >= 15 is a structurally empty set. 12 sits under 15 the
#   same way ALERT_RENDERING_STALE_MIN does.
# ALERT_TITLING_STUCK_MIN — how long an Ad may sit with an open titling
#   debt (Ad.titlingResumeState 'pending'/'claimed') before this alerts.
#   Added 2026-08-20 — see services/backlogWatchdog.js's comment on this
#   check for the incident that showed there was previously NO signal at
#   all here. 45m = 3x titlingResumeService's own CLAIM_STALE_MIN (15),
#   giving one full stale-reclaim cycle plus margin before paging.
# ALERT_HOURLY_SPEND_USD — trailing-hour CostLog total that trips a
#   warning. Video dominates, but the old justification here was WRONG and
#   this threshold was tuned against it: it claimed a 4:5 canvas cannot run
#   on Omni and falls back to Grok at $0.50/s (~$4.00 for an 8s clip).
#   It does not. `omniFamilyNativeFor()` (atlasVideoService.js:508-522) ends
#   `return r < 1 ? '9:16' : '16:9'`, so 4:5 routes to Omni 9:16 and 1:1 does
#   too unless SQUARE_VIA_OMNI_CROP=false; the compositor then crops
#   face-anchored. Grok is only the square opt-out and explicitly-selected
#   non-Omni models. Real Omni cost is `(4k ? $1 : $0.2) + duration x $0.1`
#   = **$1.00 for an 8s 1080p clip**, roughly 4x LOWER than the old comment.
#   So this ceiling is ~4x too high to catch what it was meant to catch —
#   re-tune it against measured CostLog rather than the stale figure.
ALERTS_ENABLED=true
ALERT_MIN_LEVEL=warn
ALERT_DEDUPE_WINDOW_MIN=15
ALERT_RATE_LIMIT_MAX=20
ALERT_WATCHDOG_INTERVAL_MIN=5
ALERT_RENDERING_STALE_MIN=12
ALERT_RUN_STALE_MIN=45
ALERT_RUN_SILENCE_MIN=12
ALERT_DETECT_BACKLOG_COUNT=25
ALERT_DETECT_BACKLOG_MIN=20
ALERT_TITLING_STUCK_MIN=45
ALERT_HOURLY_SPEND_USD=25

# Static direct-overlay plate generation. MEASURED 2026-07-31: a real
# openai/gpt-image-2/edit call with this service's exact payload (1 reference,
# 1024x1024, quality medium) took 69.7s. The former 60s bound sat below that
# floor and failed most renders intermittently, while still being billed —
# Atlas charges on submit. 600s is deliberately generous: the poller now reads
# Atlas's error envelope, so a long ceiling is only spent on requests that are
# genuinely still processing. Keep it BELOW REAP_STALE_MIN (default 15m/900s),
# past which a render can be reclaimed and re-billed. Re-measure before lowering.
# RAISED 600s -> 900s (2026-08-05), from MEASURED data rather than intuition.
# CostLog over 210 successful openai/gpt-image-2/edit renders:
#   p50 72.2s · p90 138.4s · p95 202.3s · p99 367.2s · MAX 474.7s
# 600s was only 1.26x the observed max on a model with a 5x p50->p99 spread, and
# 2 of 38 submits in an earlier sample died as poll timeouts (late completions).
# Waiting longer is close to free: we are billed AT SUBMIT, so extra patience only
# increases the chance we collect what we already paid for. Since 2026-08-18
# MAX_CREATIVES_PER_RUN is 1000 (effectively uncapped), so RENDER_CONCURRENCY(24)
# is a wave size under the claim — a straggler now holds a wave slot until it
# finishes (the 2026-08-05 note that 24>20 made a straggler cost-free is
# historical). 0 of 784 successful renders exceeded 600s, so
# this is headroom for the tail, not a fix for a known failure.
AI_DIRECT_IMAGE_TIMEOUT_MS=900000

# Post-render vision QC on finished static ads (services/adVisionQcService.js).
# Compares the ORIGINAL product photo against the FINISHED render; on fail it
# regenerates exactly ONCE, then flags and stops. Each regen is a billable image
# submit and the vision call is a billable LLM call, so this is a spend decision
# as much as a quality one.
#
# Shipped dark until 2026-08-05. BOTH preconditions this block required are now
# satisfied, so it is ON:
#   1. ROUTABLE — confirmed live 2026-08-05, not inferred from the catalog:
#      POST https://api.atlascloud.ai/v1/chat/completions with
#      model=google/gemini-2.5-pro returned HTTP 200, finish_reason 'stop', and
#      valid JSON. (The gpt-5-nano trap in atlasModelMap is a listed-but-NOT-
#      routable model returning HTTP 400 "router not found", which is why a
#      catalog listing was never accepted as proof.)
#   2. COST accepted (owner, 2026-08-05). Live catalog pricing for 2.5-pro is
#      $1.25/M in, $10/M out; a check is ~2 images + prompt, so roughly
#      $0.01-0.03 including the model's reasoning tokens — against the
#      ~$0.0717 gpt-image-2/edit render it protects.
#
# WHAT TURNING THIS ON COSTS, stated plainly: every static surface also pays one
# vision call (~$0.01-0.03), and a FAILED verdict spends one extra billable image
# submit (~$0.0717). Hard ceiling per live render entry: 2 image submits, 2
# vision calls. Flip this to false to stop both immediately.
#
# TWO DIFFERENT FAILURE MODES, deliberately handled differently:
#   · A BAD VERDICT (empty / non-JSON / garbled) means the model DID look and we
#     cannot trust the result → scores 0 → fails CLOSED → spends the one
#     regeneration. Never silently ships an unchecked ad.
#   · A THROWN vision call (Atlas down, timeout) means the model NEVER looked →
#     the ad is stamped `visionQc.skipped` with a reason, alerted, and SHIPS on
#     the already-paid plate. It does NOT burn the regeneration, because an
#     infrastructure failure is not evidence the image was bad.
#
# This file is the effective source (config/defaults.env is dotenv-loaded at
# boot and the secrets-only migration is complete), so no Render dashboard entry
# is needed — but a dashboard var of this name would SHADOW this line (§4a).
#
# ON as of 2026-08-06. The three "ships uninspected" paths that blocked this are
# closed: recovery now judges the recovered plate (zero image submits), the
# missing-product-URL hatch stamps + alerts instead of shipping silently, and a
# thrown vision call is caught and stamped. Boot recovery was also wired to the
# stale `rendering`+receipt population it previously logged and abandoned.
#
# KNOWN AND BOUNDED (adversarial review 2026-08-06 — accepted, not unknown):
#   · Two worker instances racing recovery on the SAME ad can each pay one vision
#     call (~$0.01-0.03 wasted). Pre-spend re-read narrows but does not close it;
#     a proper claim/lease is follow-up work.
#   · Operator REGENERATE with QC on can spend up to ~$0.14 + vision and end with
#     no new creative if both attempts fail QC. The previous render is preserved.
#   · If QC fails AND the Cloudinary discard upload also fails, the paid pixels
#     live only at the Atlas receipt (30d) with no automatic finishPlate path.
# None of these ship a defective ad, and none can exceed the 2-submit ceiling.
#
# RUNTIME OVERRIDE — flip QC on/off with NO REDEPLOY AND NO RESTART.
#   This env var is only the FALLBACK tier. The live lever is the Mongo
#   SystemConfig singleton, which wins over it:
#     SystemConfig.adVisionQcEnabled = true   → force QC ON  (beats env)
#     SystemConfig.adVisionQcEnabled = false  → force QC OFF (explicit kill
#                                               switch; beats env true)
#     SystemConfig.adVisionQcEnabled = null   → fall through to this env var,
#                                               then to the default (false)
#   Flip it either way:
#     await require('./services/systemConfigService').setAdVisionQcEnabled(true)
#     db.systemconfigs.updateOne({key:'default'},{$set:{adVisionQcEnabled:true}},{upsert:true})
#   Both web and worker pick the change up within the ~5s getter TTL cache, so a
#   flip lands on the next render cycle. On a cold process the cache is empty and
#   the first read answers from this env var while it warms in the background —
#   so expect up to one cache window of lag right after a deploy.
#   A Mongo read failure is fail-safe: it logs once and falls back to env/default,
#   and can never throw into a render.
#   Reporting when it runs is deliberately VERBOSE — every verdict logs the score,
#   the per-category breakdown with the failing category marked, and the retry
#   decision, and echoes to Slack via alertService.notifyAsync (fire-and-forget,
#   never awaited: this path runs AFTER a billable image generation, so Slack
#   latency must never delay or fail a render). Pass echoes at 'warn' because
#   ALERT_MIN_LEVEL=warn means 'info' would never deliver; volume is bounded by
#   alertService's 20/min info+warn rate limiter.
#   Fenced by scripts/verifyQcGateWiring.js. Floors are unchanged: PASS_FLOOR=7,
#   MAX_QC_REGENERATIONS=1.
AD_VISION_QC_ENABLED=false
# LEGACY — kept for backward compat, do not remove. Split 2026-08-21 into
# STATIC_VISION_QC_ENABLED / VIDEO_VISION_QC_ENABLED below, one gate per
# pipeline. This var still works as a shared fallback: if either new var is
# entirely unset, its pipeline falls back to reading THIS one (see
# adVisionQcService.js staticEnvEnabled/videoEnvEnabled). The real switch in
# production right now is SystemConfig.adVisionQcEnabled=true (DB), not this
# file — see the two new SystemConfig fields' migration-bridge comments in
# models/SystemConfig.js for why removing this var or the DB field early
# would ship uninspected ads.
STATIC_VISION_QC_ENABLED=false
VIDEO_VISION_QC_ENABLED=false
# Optional model override. Otherwise role 'ad-vision-qc' resolves via
# atlasModelMap to google/gemini-2.5-pro — NOT flash: flash was probed live
# against this exact defect and broke the requested JSON shape (returned
# competitor_marks as a bare bool and hoisted findings), which either ships a bad
# ad or burns the one regeneration for nothing.
# AD_VISION_QC_MODEL=
# services/videoQcFrameSelectionService.js — dense, early-weighted frame
# pre-filter in front of the video vision QC call above. Default true.
# Quartile sampling alone (25/50/75%) is blind to a defect that appears and
# disappears inside one quartile window (2026-08-20 storefront-chrome
# incident: visible at t=0.1s/0.5s, gone by t=2.5s on a ~10s clip). This
# probes a dense, cheap (non-billable) frame set, scores each against the
# clip's own steady state, and adds up to 2 flagged frames to the existing
# 3-frame quartile baseline only when the local probe actually looks
# suspicious — a clean clip costs exactly the same as before. false
# restores the byte-identical pre-existing quartile-only frame set with no
# deploy. See that module's file header for the full design.
VIDEO_QC_DENSE_SAMPLING=true

# ── Brand fonts from Meta ads (metaAdsFontService) ───────────────────
# Second source for a brand's real typeface, for the common premium-DTC case
# where the WEBSITE scan cannot get the file: the foundry CDN 403s us, or the
# font stack is injected by JS so no @font-face is in the fetched HTML. The ads
# still show the typeface, so a vision model NAMES it and the resolver serves
# that name exactly when possible.
# This only ever produces a NAME, never a font file — a raster creative has no
# font embedded in it. Only a 'high'-confidence identification is allowed to
# outrank a curated theme, and then only if it resolves to a real file.
# Cost per brand: ~$0.02-0.03 (one gemini-2.5-pro call + $0.005/image), ONE TIME
# — gated on Brand.metaFontsIngestedAt, same as the website scan's gate.
META_ADS_FONTS_ENABLED=true
# Images sent to the vision call. This is the ledger's per-image surcharge
# multiplier, so raising it raises cost linearly.
META_ADS_FONTS_MAX_IMAGES=4
# Optional model override; otherwise role 'font-vision' → google/gemini-2.5-pro.
# Do NOT point this at flash without re-probing: flash broke the JSON contract on
# the sibling ad-vision-qc task, and a malformed verdict here reads as
# "identified nothing".
# META_ADS_FONTS_MODEL=
# Public Ad Library scrape — the LAST resort, used only for a brand with no
# connected Meta ad account AND no persisted creatives. BILLABLE per run and
# BLANK BY DEFAULT, so the tier is inert until an actor is named: connected
# accounts cost nothing, and this must not start spending by surprise on a
# coverage backfill across every brand.
APIFY_ADLIB_ACTOR=
APIFY_ADLIB_COST_USD=0.25

# ── Titling (Remotion) ───────────────────────────────────────────────
# When true (default), the RENDER path ignores persisted titleStyleSpec
# override documents on ad/product/category/brand. Stale brand specs were
# permanently shadowing the canonical no-scrim cinema standard
# (remotion/presets/canonical.json). Named curated presets
# (brand.titleStylePreset → remotion/presets/<name>.json) still apply;
# canonical remains the floor. Title Studio authoring/preview passes
# honourPersistedOverrides so operators can still see/edit stored docs.
# Flip to false to restore the old override cascade without a deploy.
# Stored fields are NOT deleted — this is a read-path change only.
TITLE_SPEC_IGNORE_PERSISTED=true

# Map face/subject vision boxes onto plateHints band `avoid` flags so
# resolveGroupAnchor shifts titles off faces. Reuses Ad.basePlate detection
# when the crop path already paid for it; otherwise detects once (~$0.02,
# ledgered) and caches. false → pre-keep-out behaviour (luma-only bands,
# avoid always false in basic mode).
TITLE_FACE_KEEPOUT=true

# Recovered-master titling resume (services/titlingResumeService.js, web only).
# Boot recovery stamps paid masters draft with renderStage sentinel; this
# sweeper titles them on the web process (Remotion lives there). Kill switch
# is the literal string 'false'; interval and per-pass cap are floors of 1.
TITLING_RESUME_ENABLED=true
TITLING_RESUME_INTERVAL_MIN=5
TITLING_RESUME_MAX=5
# Minutes a titling claim may sit untouched before another pass reclaims it.
# Recovers an ad whose render was killed mid-flight — without this it would sit
# `draft` + claimed forever, invisible to every other sweeper (they all key on
# status:'rendering'). Deliberately generous: this path does not heartbeat
# updatedAt, so a legitimately slow render keeps its claim-time stamp. Too LOW
# is the harmful direction (double-render, wasted CPU, no spend).
TITLING_RESUME_STALE_MIN=15
# Minutes to keep retrying an ad whose brand will not resolve before shipping the
# untitled master (mirrors routes/ads.js:1469/:1512, which treats a null brand as
# intentional success). Bounds what would otherwise be a silent infinite retry.
TITLING_RESUME_BRAND_GIVEUP_MIN=60

# ── The PREPARING-lifecycle window (services/staleness.js) ────────────
# Minutes a CampaignRun may stay in 'preparing' — from mint at POST
# /api/ads/generate until the atomic 'preparing'->'running' flip. Unlike
# REAP_STALE_MIN this is NOT a silence threshold: expandWizardJob makes ZERO
# writes to the run row for its whole duration, so updatedAt === startedAt and
# this measures time-since-mint against a job with a long HEALTHY runtime.
#
# WHY 30 AND NOT 15. worker.js's own arithmetic: the Director round alone can
# burn 2 paid attempts x (120s timeout + backoff) ~= 12 min, plus the Judge call
# on top — **~18-20 min is a realistic healthy ceiling, not a crash**. At 15 the
# flip guard was BELOW that ceiling, so an expansion finishing at T=18 min lost
# its own compare-and-swap: the ads it had just claimed were released back to
# 'queued' and the operator was shown a run that read 'failed'. 30 clears the
# ceiling with headroom.
#
# THE COHERENCE INVARIANT — read before tuning. This one value feeds THREE
# consumers, and two of them are money-facing:
#   * worker.js reapOrphans()  — stamps a stale preparing run failed (hygiene)
#   * buildRunningFlipFilter   — how long a run may still win its own flip
#   * buildActiveRunsFilter    — how long a preparing run still blocks an
#                                identical duplicate at the concurrency gate
# The last two MUST stay equal. If the flip outlives the gate, a duplicate
# request is admitted and bills while the original can still flip and bill
# again — one operator intent, two charges. They are equal by construction
# (routes/ads.js reads this getter once and passes it to both), so the way to
# break it is to hand one of them REAP_STALE_MIN again. Pinned behaviourally by
# scripts/verifyPreparingReap.js Group G.
#
# Do NOT "simplify" this onto REAP_STALE_MIN (15). That window governs CLAIMED
# work — Ad 'rendering' and CampaignRun 'running', both of which heartbeat — and
# raising it would delay orphan requeue for every one of them.
#
# Nonsense values (blank, whitespace, 0, negative, non-numeric) fall back to the
# code default rather than being honoured; a window <= 0 would make the flip's
# `startedAt >= now` unsatisfiable, i.e. a silent total generation outage.
# Must stay in lockstep with PREPARE_STALE_MIN_DEFAULT in services/staleness.js
# (CLAUDE.md §4a) — asserted by verifyPreparingReap E3.
# NOTE (§4a precedence): a Render dashboard var of this name would SHADOW this
# file. Coherence survives either way — every preparing consumer reads the same
# getter — but the value prod actually runs would be the dashboard's.
PREPARE_STALE_MIN=30

# ── Queued-leftover archive (services/queuedArchiveSweeper.js) ────────
# expandWizardJob mints every implied ad; selectAdsForRun claims
# MAX_CREATIVES_PER_RUN (1000 since 2026-08-18 — effectively uncapped, so a
# realistic Everything run is claimed in one go). Pathological leftovers
# (mint still > claim) sit status:'queued' forever and a later Generate on
# the same product can claim and BILL them (CLAUDE.md §2).
# After this many hours, leftovers whose minting run is terminal
# (done/failed) move to status:'archived' — reversible, never deleted,
# never claimable. 24h leaves a same-day POST /runs ("Generate more")
# window. Blank / 0 / negative fall back to 24 (Number('') === 0 would
# otherwise archive the moment a run finished).
# WORKER-only (no Remotion / no submit). Kill switch is the literal
# string 'false'.
QUEUED_ARCHIVE_ENABLED=true
QUEUED_ARCHIVE_AFTER_H=24
QUEUED_ARCHIVE_MAX_ADS=200
QUEUED_ARCHIVE_INTERVAL_MIN=15

# ── Quote tiering (services/layoutInputService.js) ───────────────────
# Brand-tier review quotes may win as a LAST-RESORT fallback on product-scoped ads (below product/category/comment tiers, never above them); set false to restore withholding brand quotes from product ads entirely.
#
# LEFT ON deliberately (owner, 2026-08-11). Flipping this off was considered as
# a fix for a bad quote and REJECTED, because provenance is the wrong axis:
# "I don't care if the review is brand or product, the question isn't
# provenance, it's whether it is helping or hurting our advertisement."
# A brand-tier line that sells the product is welcome; a product-tier line that
# reads badly is not. The bar is enforced on the QUOTE, in
# services/quoteSnippetService.js (see PROOF_BAR), not on where it came from.
QUOTE_BRAND_TIER_FALLBACK=true
# Stamp a quote's origin from its productReviews container (via the same
# classifyProductReviewsProvenance the ratings path uses) when the quote has
# none. Ported from liquidretail_backend 2026-08-24 alongside the
# layoutInputService fix — WITHOUT this committed default a fresh adgen boot
# runs the fixed code with the flag unset. It reads `|| 'true'` so unset still
# resolves on, but shipping it explicitly keeps the two repos' committed
# defaults identical, which is the whole point of the port.
QUOTE_ORIGIN_FROM_CONTAINER=true

# ── Quote noun-scope (services/quoteProvenance.js) ───────────────────
# DEFAULT ON since 2026-08-19. A brand/unstamped-tier quote that names a
# SPECIFIC garment (jacket, hoodie, dress, ...) is only kept when that
# garment matches this ad's own product/seed labels; a quote naming no
# garment at all (generic brand praise) is always kept. This is not the
# QUOTE_BRAND_TIER_FALLBACK axis above and does not reopen that decision —
# "helping vs hurting" is exactly why this exists: a quote describing a
# DIFFERENT garment is hurting, not helping, no matter which tier it came
# from. Verified live: a Vuori tee ad with zero product reviews of its own
# had its cached brand-tier primary_quote holding a bomber-jacket review
# ("...it's a bomber-style jacket and cinched at the waist...") because the
# prior scoping (product-attached ads were exempt from this check
# entirely — see quoteProvenance.js header) never noun-checked it. Set
# false to restore that exemption and the pre-2026-08-19 media-driven-only
# behaviour, no deploy needed.
QUOTE_PROVENANCE_STRICT=true

# ── Director proof menu (services/aiCreativeDirectorService.js) ───────
# ON since 2026-08-10. Surfaces every available proof point across product /
# category / brand tiers to the Director as social_proof_signal.proof_options[],
# each carrying its OWN pre-scoped disclosure string, so a product-scoped run can
# ground a proof-led concept on brand-wide numbers without ever phrasing them as
# that SKU's own. The narrower primary_quote / rating fields stay withheld on
# product runs (cross-product copy guard) — this is additive.
#
# WHY IT WAS FLIPPED: social-proof static ads had collapsed to 18 renders against
# brand_led's 200+ (measured in prod logs 2026-07-30..08-06). Starving the
# Director of brand proof on product runs was one of the two causes.
#
# PAIRED with the DIRECTOR_SIGNALS_VERSION bump in aiCreativeDirectorService.js
# (now 3.2.0). Scope of that bump, stated precisely because an earlier draft of
# this comment overstated it: the LIVE path (directConceptsRound) has NO
# signalsVersion cache gate and re-assembles every round, so this flag takes
# effect immediately with or without the bump. The bump matters for the SHADOW
# directConcepts path, which IS keyed on that constant — it stops artifacts built
# from the narrower signal shape being served as current, at the cost of one paid
# re-derive per shadow cache key on next request.
#
# This flag also amends the prompt's HONESTY RULE (same flag) so the rule cannot
# forbid proof while this menu is offering it. Setting it back to false restores
# the pre-change prompt byte-for-byte, original honesty-rule string included.
DIRECTOR_PROOF_MENU_ENABLED=true

# DIRECTOR_PROMOTIONAL_STYLE — routing.creative_style="promotional" is OPT-IN
#   as of 2026-08-12 (owner: "strip promotional campaigns being generated at
#   all unless specifically requested"). Default behaviour: the style is
#   offered ONLY when Campaign.kind === 'promotional'.
#   WHY: the copy that style asks for — an offer, a price, an urgency number —
#   is exactly what validateDirectorPayload rejects unconditionally, so a round
#   that picked it burned a second PAID Director call (measured 19.1s on the
#   2026-08-12 live run) to be told a rule the prompt never stated.
#   The narrowing is applied to BOTH the prompt menu and the response-schema
#   enum; withholding it from only one re-creates that contradiction.
#   Set to "always" to restore the pre-2026-08-12 behaviour (offered on every
#   run) without a deploy. Any other value, including blank, keeps opt-in.
DIRECTOR_PROMOTIONAL_STYLE=

# ── Static social proof: labelled brand stars beside a product/comment quote ──
# Owner override of ratingDisplay.js tier-coherence invariant #4, 2026-08-07:
# *"I don't want brand level stars to block a comment tier quote… include a
# 'Brand Reviews' next to the stars."* Measured cause: 7 of 18
# ai_social_proof_led renders fell back to objection_resolved because a
# comment-tier quote hard-nulled otherwise-usable brand stars, and that intent's
# core IS the rating.
#
# STATIC ONLY. resolveCoherentSocialProof defaults the behaviour OFF and only
# directImageRenderService opts in, so video titling is unaffected by
# construction. Brand STARS only (never a count alone), and only when a brand
# review count exists to carry the "brand reviews" scope label — no count means
# no label vehicle, so it refuses rather than print a bare unscoped star rating.
# Product numbers always win when present; this can only ADD proof.
#
# Set false to restore the strict invariant with no deploy.
STATIC_BRAND_STARS_WITH_QUOTE=true

# QUOTE ELIGIBILITY FLOOR — which reviewers may be QUOTED (owner, 2026-08-04).
# Distinct from the STAR floor (services/ratingDisplay.js RATING_STAR_MIN = 4.39),
# which governs which NUMBER may print. Owner asked for this one to live in env so
# it can move without a deploy.
#
# 4.35, deliberately BELOW the star floor's 4.39: this gate compares the RAW
# rating while the star gate compares the ROUNDED display value. A raw 4.37
# displays as "4.4" and so prints stars — a 4.4 cut-off here would refuse to quote
# that same reviewer, and the ad would show stars beside a quote borrowed from
# another tier.
#
# Raising this above 4.39 re-opens that incoherence. Lowering it admits weaker
# endorsements as printed testimonials.
QUOTE_MIN_RATING=4.35

# CLOUDINARY_MAX_UPLOAD_BYTES — PROVIDER ceiling, plan-dependent. Cloudinary
#   rejects a larger upload with HTTP 400 "File size too large. Got <n>.
#   Maximum is <limit>.", and the limit moves with the subscription: the
#   2026-08-04 crash hit 20971520 (20 MiB) and the account was upgraded to
#   40 MiB the same day. NOT a self-imposed tuning knob — set it to whatever
#   the plan actually allows, read from that 400 message, and nothing else.
#   Consumed by atlasVideoService.fitBufferForCloudinary, which refits an
#   oversized reframe rather than discarding a generation we already paid for
#   (REFRAME_RESOLUTION=4k routinely produces large buffers).
CLOUDINARY_MAX_UPLOAD_BYTES=41943040

# ── Home-page agent (backlog rows 167, 168) ──────────────────────────
# Master switch for the conversational agent at POST /api/agent/chat.
# Ships OFF by default; flip to true per env once the frontend chat
# drawer lands. When false, the endpoint returns 503 and the router is
# still mounted (so the frontend can probe availability without a 404).
AGENT_ENABLED=true

# Model the agent routes through atlasLlmService.chatCompletion.
# Default = gemini-2.5-flash (cheap + fast, tool-calling verified on
# this stack). Alternatives: `director` (Claude Sonnet-5 via
# anthropic/claude-sonnet-5-ccmax) for planning-heavy tier 4 workflows.
AGENT_MODEL=gemini-2.5-flash

# Cap on the LLM ↔ tool-use loop iterations before the endpoint bails
# with stop_reason='max_iterations'. 8 covers list→inspect→answer
# chains with headroom.
AGENT_MAX_ITERATIONS=8

# Cap on incoming client-side chat history per request. 0 = disabled
# (no cap); any positive value enforces the limit. Kept disabled until
# the chat drawer implements client-side history compaction — cost
# defense in the meantime is AGENT_DAILY_CAP_USD + AGENT_MAX_TOKENS.
AGENT_MAX_MESSAGES=0

# Per-LLM-call max_tokens. Agent answers are short summaries of tool
# results; 2048 is generous without blowing latency.
AGENT_MAX_TOKENS=2048

# Truncation ceiling for a single tool_result payload the LLM sees.
# Bigger blobs get replaced with a "_truncated" note so the model asks
# the capability to paginate rather than hallucinating.
AGENT_MAX_TOOL_RESULT_BYTES=12000

# Per-advertiser rolling-24h USD cap for Tier ≥ 2 agent capabilities.
# 0 = DISABLED (spendGuard.check() short-circuits allowed:true and
# skips the CostLog query). Positive value = the cap in USD; every
# confirmed billable dispatch reads today's rollup + the capability's
# estimateUsd and rejects when projected > cap.
#
# Kept disabled while the agent is in active testing — the fail-closed
# "no estimator" rule for Tier ≥ 2 caps still fires regardless, so
# uncapped bugs still get caught. Re-enable per env with a positive
# value once per-user quotas or ops-facing monitoring is in place.
AGENT_DAILY_CAP_USD=0
# STATIC PROMPT — brand-led copy cascade (default ON). Maps ai_brand_led → the
# brand_led intent and fills headline/subhead from layoutInput.copy then
# brand.tagline when Director nulls them. false restores a byte-identical
# pre-change prompt (TEMPLATE_INTENT entry + both cascades + SUBHEAD role all
# revert together).
STATIC_BRAND_LED_COPY=true

# STATIC PROMPT + Director copy contract — rating furniture (default ON).
# social_proof_led must render a star-glyph widget + numeral + count, not
# paraphrase the rating into a headline. Also rejects unqualified universal
# endorsement ("by everyone", "everyone who's tried them", "universally",
# "all customers") in Director copy, and relocates "brand-wide" from headline
# adjective to the widget qualifier. false restores a BYTE-IDENTICAL
# pre-change static prompt (star-row ban, original goal, no furniture note)
# AND the pre-change Director prompt/validator. Same kill-switch pattern as
# STATIC_PROMPT_FIDELITY_HARDENING / STATIC_BRAND_LED_COPY. NOT a money knob.
# Pinned by scripts/verifyRatingFurniture.js (both arms, revert-proven).
STATIC_RATING_FURNITURE=true

# STATIC PROMPT — PMax platform notes + intent-aware CTA (default ON). Injects
# a PLATFORM_NOTES block after the FORMAT/geometry block on pmax_* surfaces
# only, and rewrites drawCta for those surfaces by intent (true only for
# objection_resolved / conversion). Meta surfaces are NEVER touched — their
# prompts stay byte-identical with the flag on or off. false restores a
# byte-identical pre-Phase-B prompt for every surface including pmax_*
# (no notes block; pmax drawCta stays the per-surface SURFACE_POLICY boolean).
# Same kill-switch pattern as STATIC_PROMPT_FIDELITY_HARDENING /
# STATIC_BRAND_LED_COPY above. NOT a money knob — prompt text only.
PMAX_STATIC_PLATFORM_NOTES=true


# ── PMax Director proof thresholds (services/aiCreativeDirectorService.js) ──
# Interpolated into the PMax-ONLY round brief (funnel spread + social-proof
# hierarchy). Meta rounds never see these values. Changing them changes the
# prompt text the Director receives — they are creative policy knobs, not
# money knobs.
# Strong-rating floor for RATING-FIRST vs POPULARITY framing decisions.
PMAX_PROOF_STRONG_RATING=4.5
# Minimum review count treated as "substantial" (below this, omit the count —
# a small number reads as a negative).
PMAX_PROOF_MIN_REVIEW_COUNT=100


# ── PMax derive-only 1:1: in-render wait for its 9:16 master (routes/ads.js) ──
# The derive-only square holds a render slot while it waits for the sibling
# master's already-paid plate — it makes NO billable submit, so waiting costs
# nothing. It waits because the whole run dispatches in one wave
# (VEO_CONCURRENCY), so on a first Google run the master is always still
# rendering when the derive ad starts; the old immediate requeue stranded it
# (nothing drains a `queued` ad, and a second Generate short-circuits as
# "Nothing to render"). An Omni master settles in ~2 minutes; 12 minutes is
# headroom, not an expected wait. Raise only if masters are queueing behind a
# saturated pool.
DERIVE_MASTER_WAIT_MS=720000
DERIVE_MASTER_POLL_MS=10000


# ── Meta default video duration (services/campaignAdsGenerationService.js) ──
# Owner decision 2026-08-11: standardise Meta masters on 10s (was the provider
# default 8s). Industry guidance puts Stories — the current Meta master surface
# — at 6-10s and Reels/feed higher, and 10s is Omni's ceiling.
# NOT a re-mint: duration is part of the identity digest only for Google PMax
# video formats, so every existing Meta ad keeps its digest and a repeat
# Generate still re-renders nothing. Future masters are longer and cost
# proportionally more (10s settles at $0.90 on the developer model).
# Kill switch: set empty or 0 to fall back to the provider default (8s).
META_VIDEO_DURATION_SEC=10
