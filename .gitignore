node_modules/
.env
.env.local
*.log
.DS_Store
dist/
.claude/*
# Committed hook wiring for the stranded-work audit (see CLAUDE.md's
# "Stranded-work tooling" section) — un-ignore just these two paths.
# settings.local.json (per-developer overrides) and .claude/worktrees
# (Claude Code's own scratch worktrees) stay ignored via the .claude/*
# blanket rule above.
!.claude/settings.json
!.claude/hooks/
.codegraph/
.codemap/
# Remotion webpack bundle — built at Docker build time by
# scripts/prebuildRemotionBundle.js. Local runs are for smoke-testing
# only and should never commit their output.
.remotion-bundle/
# Build-time browser prewarm hint — written by scripts/ensureRemotionBrowser.js.
# Not consumed by the Dockerfile (the ENV there is a literal, checked against
# this by scripts/verifyRemotionBrowserPrewarm.js) or by runtime; local-only.
.remotion-browser-path
probe-results/
# scripts/renderTitlePreview.js default output dir — local debug PNGs/MP4s,
# never committed (same pattern as probe-results/ above).
title-preview-output/
